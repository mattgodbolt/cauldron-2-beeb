\ 9 (24, 36, 41) and 10 (16, 40, 42): once its anim has stopped, push
\ the pumpkin right (24031 bit 3) or left (bit 2).
.z56929
{
    JSR z56949
    BNE done
    LDA a24031 : ORA #8 : STA a24031
.done
    RTS
}
.z56939
{
    JSR z56949
    BNE done
    LDA a24031 : ORA #4 : STA a24031
.done
    RTS
}

\ 56949: Z if the other's anim (24021) is empty or stopped.
.z56949
{
    LDA a24021
    JSR z57371
    LDY #13 : LDA (rix),Y
    BMI stopped
    BEQ stopped
    RTS
.stopped
    LDA #0
    RTS
}

\ 56967 Overlap: NZ and A = the first of slots 2-5 (not CurSlot) that
\ slot IX overlaps: |dx| < 4 x the width of the one further left, |dy| <
\ the height of the one higher up. Else Z.
.z56967
{
    LDA a24022 : STA rc
    LDA #2 : STA rb
    LDA #LO(a24117) : STA riyl : LDA #HI(a24117) : STA riyh
.slot
    LDY #13 : LDA (riy),Y
    BEQ next
    LDA rc : CMP rb
    BEQ next
    LDY #6 : LDA (rix),Y : SEC : SBC (riy),Y
    BCS x_right                         ; IX is the right one: IY's width
    EOR #&FF : ADC #1                   ; (C clear) |dx|
    PHA : LDY #17 : LDA (rix),Y
    JMP x_width
.x_right
    PHA : LDY #17 : LDA (riy),Y
.x_width
    ASL A : ASL A : STA rd
    PLA
    CMP rd : BCS next
    LDY #7 : LDA (rix),Y : SEC : SBC (riy),Y
    BCS y_below
    EOR #&FF : ADC #1
    LDY #18 : CMP (rix),Y
    JMP y_test
.y_below
    LDY #18 : CMP (riy),Y
.y_test
    BCS next
    LDA rb                              ; (NZ: 2 to 5)
    RTS
.next
    LDA #20 : STA re : LDA #0 : STA rd
    LDA riyl : CLC : ADC #20 : STA riyl
    BCC nc
    INC riyh
.nc
    INC rb
    LDA rb : CMP #6 : BNE slot
    LDA #0
    RTS
}
