\ 5 (32, a refill): taken for this game (61521 bit 7), firing allowed
\ (24017), removed, MAGIC 99, +100.
.z56747
{
    LDA a24030
    LDX #0
.find
    CMP a61521,X : BEQ found
    INX : CPX #52 : BNE find
    RTS
.found
    LDA a61521,X : ORA #128 : STA a61521,X
    STA a24017
    LDA a24021
    JSR z55551
    LDA #'9' : STA a58813 : STA a58814
    G_DE a58835
    JSR z57568                          ; (minus 0: prints it)
    G_DE a58850
    JMP z57616
}

\ 6 (26, the cauldron): 56811, the win, is the front end's (frontend.6502).

\ 7 (44): with the scissors (34) and not yet the moon (7), the moon,
\ +1000, a sound. It stays.
.z56871
{
    LDA #34 : JSR z56729
    BNE done
    LDA #7 : JSR z56729
    BEQ done
    LDA #3
    JSR z56521
    G_DE a58870
    JSR z57616
    G_HL a64014
    JMP z52781
.done
    RTS
}

