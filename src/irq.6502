\ ***************************************************************************
\ The interrupt handler. It owns IRQ1V outright (after the port kit's
\ lib/irq.6502, by way of ../cauldron-beeb): nothing goes to the OS, so the
\ OS's 100Hz tick, sound and keyboard interrupt stop, and its workspace
\ stays still.
\
\ Two sources: VSync (System VIA CA1) and the User VIA's T1, which splits
\ the palette down the screen (decision 4). T1 runs free: VSync starts it
\ and sets its latch to the period after, and each split sets the one
\ after that, so only VSync's latency moves the splits.
\
\ In MODE 1 a palette entry is picked by more than the pixel's own colour:
\ the ULA forms the entry number from bits 7, 5, 3 and 1 of a shift
\ register that moves one bit a pixel, so a pixel's entry depends on its
\ neighbour's too. Entry i shows logical colour (bit 3 of i, bit 1 of i):
\ each logical colour has four entries. A split changes one logical
\ colour, four writes, which fit a horizontal blank (16us of 32).
\
\ A screen's colours are a palette program: the sixteen entries VSync
\ writes (frame_ula) and up to MAX_SPLITS splits, each one logical colour
\ (split_ula) at a line set by T1's periods (split_latch).
\ ***************************************************************************

\ The &FE21 value for entry i showing physical colour phys.
FUNCTION ula_value(i, phys) = i * 16 + (phys EOR 7)
\ Logical colour l's first entry; its others are 1, 4 and 5 more.
FUNCTION ula_base(l) = (l AND 2) * 4 + (l AND 1) * 2

\ Physical colours.
PHYS_BLACK   = 0
PHYS_RED     = 1
PHYS_GREEN   = 2
PHYS_YELLOW  = 3
PHYS_BLUE    = 4
PHYS_MAGENTA = 5
PHYS_CYAN    = 6
PHYS_WHITE   = 7

MAX_SPLITS = 32
\ When a split at line 8 fires, in microseconds after VSync, plus 8 lines:
\ cauldron-beeb's sweep (its decision 4, the same screen geometry and
\ handler) put the clean window at 88 to 116 on the B and the Master;
\ 102 sits in the middle. To sweep again here with tools/splitsweep.py.
IF DEFINED(SPLIT_SWEEP)
    SPLIT_ADJ = SPLIT_SWEEP
ELSE
    SPLIT_ADJ = 102
ENDIF
\ The first split's line (tools/mkscreen.py's FIRST_SPLIT_LINE) and when
\ it fires after VSync.
FIRST_SPLIT_LINE = 8
SPLIT_FIRST = 83 * SL + SPLIT_ADJ - 8 * SL
\ The periods between splits (a VIA timer counts its latch + 2).
FUNCTION t1_period(lines) = lines * SL - 2

.irq_handler
{
    ZA_INTERRUPT
    TXA : PHA
    BIT usrvia_ifr : BVC not_t1     ; (T1's flag is bit 6)
    LDA usrvia_t1cl                 ; acknowledge
    LDX irq_split
    LDA split_ula,X : STA ula_pal
    LDA split_ula+1,X : STA ula_pal
    LDA split_ula+2,X : STA ula_pal
    LDA split_ula+3,X : STA ula_pal
    TXA : LSR A : TAX               ; (4 * the split: 2 * it indexes split_latch)
    LDA split_latch+2,X : STA usrvia_t1ll
    LDA split_latch+3,X : STA usrvia_t1lh
    LDA irq_split : CLC : ADC #4 : STA irq_split
    JMP done
    ZA_UNREACHABLE
.not_t1
    LDA sysvia_ifr : AND #2 : BEQ done
    STA sysvia_ifr                  ; acknowledge
    INC vsyncs
    LDA splits_on : BEQ palette
    LDA #LO(SPLIT_FIRST) : STA usrvia_t1cl
    LDA #HI(SPLIT_FIRST) : STA usrvia_t1ch     ; starts the count
    LDA split_latch : STA usrvia_t1ll          ; ... then from split 0 to 1
    LDA split_latch+1 : STA usrvia_t1lh
.palette
    LDX #15
.entries
    LDA frame_ula,X : STA ula_pal
    DEX : BPL entries
    INX : STX irq_split             ; 0
    LDA vsync_hook+1 : BEQ done     ; (the sound's, once it has one)
    JSR call_hook
.done
    PLA : TAX
    LDA &FC                         ; the interrupted A, saved by the OS
    RTI
.call_hook
    JMP (vsync_hook)
}
    ASSERT MAX_SPLITS * 4 < 256

\ Split X (0 to MAX_SPLITS - 1) shows physical colour A as logical colour
\ Y. X and Y are kept.
.set_split
{
    ZA_AUTO1 phys
    EOR #7 : STA phys
    TXA : PHA
    ASL A : ASL A : TAX             ; split_ula + 4 * the split
    LDA split_base,Y : ORA phys
    STA split_ula,X                 ; entry base
    ORA #&10 : STA split_ula+1,X    ; base + 1
    ORA #&40 : STA split_ula+2,X    ; base + 5
    AND #&EF : STA split_ula+3,X    ; base + 4
    PLA : TAX
    RTS
}
.split_base
FOR l = 0..3
    EQUB ula_base(l) * 16
NEXT
.entry_logical
FOR i = 0..15
    EQUB (i AND 8) DIV 4 + (i AND 2) DIV 2
NEXT

\ Install a palette program, as tools/mkscreen.py writes them: at (pp),
\ the number of splits n, logical 0-3's physical colours at VSync, then n
\ pairs (logical, physical) for the splits, then n + 1 T1 periods (the
\ first from split 0 to 1; &FFFF after the last). Split 0 lands at
\ FIRST_SPLIT_LINE. Called with the splits off or from the main program:
\ it turns them off while it writes.
.set_palette
{
    ZA_AUTO2 pp
    ZA_AUTO1 n, tmp
    STA pp : STY pp+1
    LDA #0 : STA splits_on
    LDY #0 : LDA (pp),Y : STA n
    \ VSync's sixteen entries from logical 0-3's colours.
    LDX #15
.entry
    TXA : ASL A : ASL A : ASL A : ASL A : STA tmp
    LDY entry_logical,X : INY
    LDA (pp),Y : EOR #7 : ORA tmp : STA frame_ula,X
    DEX : BPL entry
    \ The splits.
    LDA n : BEQ none
    LDX #0 : LDY #5
.split
    TYA : PHA
    LDA (pp),Y : PHA                ; logical
    INY : LDA (pp),Y : STA tmp      ; physical
    PLA : TAY : LDA tmp
    JSR set_split
    PLA : CLC : ADC #2 : TAY
    INX : CPX n : BNE split
    \ The periods: n + 1 words.
    LDX #0
.latch
    LDA (pp),Y : STA split_latch,X : INY : INX
    LDA (pp),Y : STA split_latch,X : INY : INX
    TXA : LSR A : CMP n : BCC latch : BEQ latch
    LDA #1 : STA splits_on
.none
    RTS
}

\ Wait for the next VSync.
.wait_vsync
{
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
    RTS
}
