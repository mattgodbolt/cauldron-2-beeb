\ ***************************************************************************
\ The interrupt handler. It owns IRQ1V outright (after the port kit's
\ lib/irq.6502, by way of ../cauldron-beeb): nothing goes to the OS, so the
\ OS's 100Hz tick, sound and keyboard interrupt stop, and its workspace
\ stays still.
\
\ Two sources: VSync (System VIA CA1) and the User VIA's T1, which splits
\ the palette down the screen (decision 4). T1 runs free: VSync starts it
\ and sets its latch to the period after, and each split sets the one
\ after that, so only VSync's latency moves the splits.
\
\ In MODE 1 a palette entry is picked by more than the pixel's own colour:
\ the ULA forms the entry number from bits 7, 5, 3 and 1 of a shift
\ register that moves one bit a pixel, so a pixel's entry depends on its
\ neighbour's too. Entry i shows logical colour (bit 3 of i, bit 1 of i):
\ each logical colour has four entries. A split changes one logical
\ colour, four writes, which fit a horizontal blank (16us of 32).
\
\ A screen's colours are a palette program: the sixteen entries VSync
\ writes (frame_ula) and up to MAX_SPLITS splits, each one logical colour
\ at a line set by T1 (split_first, then each split's record in
\ split_rec: its four writes and the latch it sets, all a split reads).
\ ***************************************************************************

\ The &FE21 value for entry i showing physical colour phys.
FUNCTION ula_value(i, phys) = i * 16 + (phys EOR 7)
\ Logical colour l's first entry; its others are 1, 4 and 5 more.
FUNCTION ula_base(l) = (l AND 2) * 4 + (l AND 1) * 2

\ Physical colours.
PHYS_BLACK   = 0
PHYS_RED     = 1
PHYS_GREEN   = 2
PHYS_YELLOW  = 3
PHYS_BLUE    = 4
PHYS_MAGENTA = 5
PHYS_CYAN    = 6
PHYS_WHITE   = 7

\ (A split at each character row boundary at most, and the first.)
MAX_SPLITS = SCREEN_ROWS
\ A split's record in split_rec: its four &FE21 writes, then T1's latch
\ it sets (the period from the next split to the one after).
SPLIT_REC = 6
\ When a split at line 8 fires, in microseconds after VSync, plus 8 lines:
\ cauldron-beeb's sweep (its decision 4, the same screen geometry and
\ handler) put the clean window at 88 to 116 on the B and the Master;
\ 102 sits in the middle. To sweep again here with tools/splitsweep.py.
IF DEFINED(SPLIT_SWEEP)
    SPLIT_ADJ = SPLIT_SWEEP
ELSE
    SPLIT_ADJ = 102
ENDIF
\ The first line a split may land on (tools/mkscreen.py's
\ FIRST_SPLIT_LINE), when a split there fires after VSync, and T1's count
\ from VSync for a first split at a line from it on.
FIRST_SPLIT_LINE = 8
SPLIT_FIRST = 83 * SL + SPLIT_ADJ - 8 * SL
FUNCTION split_count(line) = SPLIT_FIRST + (line - FIRST_SPLIT_LINE) * SL
\ The periods between splits (a VIA timer counts its latch + 2).
FUNCTION t1_period(lines) = lines * SL - 2

.irq_handler
{
    ZA_INTERRUPT
    STX irq_x
    BIT usrvia_ifr : BVC not_t1     ; (T1's flag is bit 6)
    LDA usrvia_t1cl                 ; acknowledge
    LDA splits_on : BEQ done        ; (T1 runs on from a screen with splits)
    LDX irq_split
    LDA split_rec,X : STA ula_pal
    LDA split_rec+1,X : STA ula_pal
    LDA split_rec+2,X : STA ula_pal
    LDA split_rec+3,X : STA ula_pal
    LDA split_rec+4,X : STA usrvia_t1ll
    LDA split_rec+5,X : STA usrvia_t1lh
    TXA : CLC : ADC #SPLIT_REC : STA irq_split
.done
    LDX irq_x
    LDA &FC                         ; the interrupted A, saved by the OS
    RTI
.not_t1
    LDA pulse_on : BEQ not_pulse    ; (a pulse's end: sound.6502's T2)
    LDA sysvia_ifr : AND #SV_T2 : BEQ not_pulse
    JSR pulse_end
    JMP done
.not_pulse
    LDA sysvia_ifr : AND #2 : BEQ done
    STA sysvia_ifr                  ; acknowledge
    INC vsyncs
    LDA splits_on : BEQ palette
    LDA split_first : STA usrvia_t1cl
    LDA split_first+1 : STA usrvia_t1ch         ; starts the count
    LDA split_first+2 : STA usrvia_t1ll         ; ... then from split 0 to 1
    LDA split_first+3 : STA usrvia_t1lh
.palette
    \ The hook first, so the music's timing (the bass's edges against the
    \ splits) doesn't hang on the palette's writes; its longest, an
    \ explosion's pulse, ends well before the picture starts.
    LDA vsync_hook+1 : BEQ entries_in     ; (the sound's, once it has one)
    JSR call_hook
.entries_in
    LDX #15
.entries
    LDA frame_ula,X : STA ula_pal
    DEX : BPL entries
    INX : STX irq_split             ; 0
    JMP done
.call_hook
    JMP (vsync_hook)
}
    ASSERT MAX_SPLITS * SPLIT_REC < 256

\ split_base: logical colour l's first entry, as &FE21's high nybble.
.split_base
FOR l = 0..3
    EQUB ula_base(l) * 16
NEXT
\ frame_ula's order (logical 3's four entries, then 2's, 1's and 0's):
\ each slot's entry, as &FE21's high nybble.
.slot_entry
FOR s = 0..15
    EQUB (ula_base(3 - s DIV 4) + (s AND 2) * 2 + (s AND 1)) * 16
NEXT

\ Install a palette program, as tools/mkscreen.py writes them: at (pp),
\ the number of splits n, logical 0-3's physical colours at VSync, then n
\ pairs (logical 1-3, physical) for the splits, then n + 2 T1 values: the
\ count from VSync to split 0 (split_count), the periods from each split
\ to the next (t1_period), and &FFFF, &FFFF after the last. Called with
\ the splits off or from the main program: it turns them off while it
\ writes.
.set_palette
{
    ZA_AUTO2 pp
    ZA_AUTO1 n, cnt, l, phys
    STA pp : STY pp+1
    LDA #0 : STA splits_on
    LDY #0 : LDA (pp),Y : STA n
    \ VSync's sixteen entries from logical 0-3's colours, in slot order.
    LDX #15
.entry
    TXA : LSR A : LSR A : EOR #3 : TAY : INY
    LDA (pp),Y : EOR #7 : ORA slot_entry,X : STA frame_ula,X
    DEX : BPL entry
    LDA n : BEQ none
    \ The splits' writes.
    STA cnt
    LDX #0 : LDY #5
.split
    LDA (pp),Y : STA l : INY
    LDA (pp),Y : EOR #7 : STA phys : INY
    TYA : PHA
    LDY l : LDA split_base,Y : ORA phys
    STA split_rec,X                 ; entry base
    ORA #&10 : STA split_rec+1,X    ; base + 1
    ORA #&40 : STA split_rec+2,X    ; base + 5
    AND #&EF : STA split_rec+3,X    ; base + 4
    PLA : TAY
    TXA : CLC : ADC #SPLIT_REC : TAX
    DEC cnt : BNE split
    \ T1: the count to split 0 and the latch for split 0 to 1, then each
    \ split's latch.
    LDX #0
.first
    LDA (pp),Y : STA split_first,X : INY
    INX : CPX #4 : BNE first
    LDA n : STA cnt
    LDX #0
.latch
    LDA (pp),Y : STA split_rec+4,X : INY
    LDA (pp),Y : STA split_rec+5,X : INY
    TXA : CLC : ADC #SPLIT_REC : TAX
    DEC cnt : BNE latch
    LDA #1 : STA splits_on
.none
    RTS
}

\ Wait for the next VSync.
.wait_vsync
{
    LDA vsyncs
.wait
    CMP vsyncs : BEQ wait
    RTS
}
