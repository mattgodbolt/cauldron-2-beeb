\ ***************************************************************************
\ Rooms: drawing a room (53949 and its helpers 54213, 54499), the panel
\ (53550, 53823), the colours
\ (decisions 10 and 11) and the sideways banks' paging.
\
\ The room's data (tiles and blocks: r_rooms; tile attributes: r_tattr;
\ its layout and colour plan, packed: room_packs) is in ROOMDATA, paged
\ in only while the room draws; everything else is GAMEDATA's, paged in
\ all the time (decision 9). So the room's tile-bank list (62954, in
\ GAMEDATA) is copied to main RAM (bank_list) before ROOMDATA is paged
\ in. What runs only with ROOMDATA in lives there (decision 21): the
\ tile loop, the unpacking of the room's pack, and the colours' making.
\ ***************************************************************************

\ The sideways banks (the loader leaves their numbers in game_bank and
\ room_bank). romshad is the OS's copy of romsel: write both.
.page_rooms
    LDA room_bank : STA romshad : STA romsel
    RTS
.page_game
    LDA game_bank : STA romshad : STA romsel
    RTS

\ The play area's rows shown or not (CRTC R6, the rows displayed): the
\ port's way of hiding the room while it draws, as the original hides it
\ by zeroing its attributes (decision 11).
.play_hidden
    LDA #6 : STA crtc_reg : LDA #4 : STA crtc_data
    RTS
.play_shown
    LDA #6 : STA crtc_reg : LDA #SCREEN_ROWS : STA crtc_data
    RTS

\ 54213, ClearPlayAttrs: after a frame, the play area's attributes (rows
\ 4-23) to 0, which hides it (play_hidden here). O: HL = 23295, DE =
\ 23296, BC = 0, as its LDIR leaves them.
.z54213
{
    JSR wait_vsync
    JSR play_hidden
    LDA #0 : TAX
.each
    STA attrs+128,X : STA attrs+256,X : STA attrs+512,X
    INX : BNE each
    LDA #LO(23295) : STA rl : LDA #HI(23295) : STA rh
    LDA #LO(23296) : STA re : LDA #HI(23296) : STA rd
    LDA #0 : STA rb : STA rc
    RTS
}

\ 54499, ShowPlayAttrs: after a frame, the attribute buffer (24225) to
\ rows 4-23's attributes, and the room shows: its palette program
\ (pal_prog) and the rows. The original copies 768 bytes, the last 128
\ into the printer buffer: only the 640 are the port's.
.z54499
{
    JSR wait_vsync
    LDX #0
.each
    LDA a24225,X : STA attrs+128,X
    LDA a24225+256,X : STA attrs+384,X
    INX : BNE each
.rest
    LDA a24225+512,X : STA attrs+640,X
    INX : CPX #128 : BNE rest
    LDA #LO(pal_prog) : LDY #HI(pal_prog) : JSR set_palette
    JMP play_shown
}

\ 53949, EnterRoom: draw room A, with the player, its monsters and its
\ item. Every register kept.
.z53949
{
    ZA_AUTO1 room
    STA room
    LDX #ZP_REGS_END - ZP_REGS - 9  ; (BC, DE, HL, IX, IY: 10 bytes)
    LDX #9
.save
    LDA rc,X : PHA
    DEX : BPL save
    JSR z54213
    \ Slot 0 (the player) kept while every slot is cleared.
    LDX #19
.keep
    LDA a24077,X : STA a24203,X
    DEX : BPL keep
    JSR z55472
    LDA room : STA a24030
    JSR room_scenery
    LDX #19
.back
    LDA a24203,X : STA a24077,X
    DEX : BPL back
    \ The player redrawn from its frame and place, as drawn there.
    LDA #0 : STA a24022
    LDA #LO(a24077) : STA rixl : LDA #HI(a24077) : STA rixh
    LDA a24083 : STA re : STA a24087
    LDA a24084 : STA rd : STA a24088
    LDA #LO(a24225) : STA rl : LDA #HI(a24225) : STA rh
    LDA a24092
    JSR z57415
    JSR z57058
    LDA #128 : STA a24078
    JSR z54264                      ; its monsters
    JSR z54229                      ; its item
    LDX #0
.restore
    PLA : STA rc,X
    INX : CPX #10 : BNE restore
    LDA room
    RTS
}

\ 53979-54151: draw room A's scenery: 5 rows of 8 blocks of 4 x 4 tiles
\ from row 4, each tile's pixels written (54464) and its attribute put in
\ the buffer at 24225 (by its screen address, 57341 from 24097), shown
\ by 54499. A tile byte becomes a tile number through the room's bank
\ list: the first (lo, hi, base) with lo <= byte <= hi adds base, else 0.
.room_scenery
{
    ZA_AUTO1 room
    ZA_AUTO2 p
    STA room
    \ The bank list into main RAM (62954, a word a room).
    ASL A : TAY
    LDA a62954,Y : STA p : LDA a62954+1,Y : STA p+1
    LDY #0 : LDA (p),Y : ASL A : ASL A : TAY       ; 1 + 4n bytes
.copy
    LDA (p),Y : STA bank_list,Y
    DEY : BPL copy
    JSR page_rooms
    LDA room : JSR room_tiles
    JSR page_game
    JMP z54499
}

\ The colours made from rp1-3 (make_patterns, make_program: ROOMDATA's)
\ for a caller with GAMEDATA in.
.make_colours
    JSR page_rooms
    JSR make_patterns
    JSR make_program
    JMP page_game

SECTION RoomData

\ Unpack room A's pack (room_packs: ROOM_PACK rooms' layouts, then their
\ plans) into room_buf, unless it's there already: most ways out of a
\ room lead to one in its pack. The unpacker is C2's loader's
\ (lib/dzx02.6502), again: that copy is gone once the game runs.
.room_in_buf    EQUB &FF            ; room_packs' offset of the pack in room_buf (&FF: none)
.room_unpack
{
    FOR i = 1..ROOM_PACK_SHIFT
        LSR A
    NEXT
    ASL A : TAY
    CPY room_in_buf : BNE fresh
    RTS
.fresh
    STY room_in_buf
    LDA room_packs,Y : STA src : LDA room_packs+1,Y : STA src+1
    LDA #LO(room_buf) : STA dst : LDA #HI(room_buf) : STA dst+1
    INCLUDE "lib/dzx02.6502"        ; (falls into its unpack)
}

\ Room A's tiles, with ROOMDATA in: its pack unpacked, its colours, then
\ the scenery as 53979-54151 draws it.
.room_tiles
{
    ZA_AUTO1 room
    ZA_AUTO2 p
    ZA_AUTO2 layout
    ZA_AUTO2 block
    ZA_AUTO2 base
    ZA_AUTO1 brow
    ZA_AUTO1 bcol
    ZA_AUTO1 trow
    ZA_AUTO1 tcol
    ZA_AUTO1 tile
    ZA_AUTO1 attr, row, col, pe, po
    ZA_AUTO2 q, q8
    STA room
    JSR room_unpack
    LDA room : JSR room_colours
    \ The layout (the original's 43750 + 40 * room): room_buf + 40 * the
    \ room's place in its pack.
    LDA #LO(room_buf) : STA layout : LDA #HI(room_buf) : STA layout+1
    LDA room : AND #ROOM_PACK - 1 : TAX : BEQ laid_out
.next_layout
    LDA layout : CLC : ADC #40 : STA layout
    BCC same_page : INC layout+1
.same_page
    DEX : BNE next_layout
.laid_out
    LDA #0 : STA brow
.block_row
    LDA #0 : STA bcol
.each_block
    \ The block: 39654 + 16 * its number.
    LDY #0 : LDA (layout),Y : STA block : STY block+1
    ASL block : ROL block+1 : ASL block : ROL block+1
    ASL block : ROL block+1 : ASL block : ROL block+1
    LDA block : CLC : ADC #LO(a39654) : STA block
    LDA block+1 : ADC #HI(a39654) : STA block+1
    LDA #0 : STA trow
.tile_row
    LDA #0 : STA tcol
.each_tile
    LDA trow : ASL A : ASL A : ORA tcol : TAY
    LDA (block),Y : STA tile
    \ The bank.
    LDA #0 : STA base : STA base+1
    LDX bank_list : BEQ no_bank
    LDY #1
.bank
    LDA tile : CMP bank_list,Y : BCC next_bank       ; below lo
    CMP bank_list+1,Y : BEQ found : BCC found        ; up to hi
.next_bank
    INY : INY : INY : INY
    DEX : BNE bank
    JMP no_bank
    ZA_UNREACHABLE
.found
    LDA bank_list+2,Y : STA base
    LDA bank_list+3,Y : STA base+1
.no_bank
    \ Its attribute, 48870 + ((base + byte) AND 8191), first: its ink
    \ colours the pixels (the original reads it after them).
    LDA tile : CLC : ADC base : STA p
    LDA base+1 : ADC #0 : AND #&1F : STA p+1
    LDA p : CLC : ADC #LO(a48870) : STA p
    LDA p+1 : ADC #HI(a48870) : STA p+1
    LDY #0 : LDA (p),Y : STA attr
    AND #7 : STA glyph_ink
    \ The cell: row trow + 4 * brow + 4, column tcol + 4 * bcol. Its
    \ attribute into the buffer (24097 + its attribute offset, as 57341
    \ gives it) and its ink as its scenery's.
    LDA brow : ASL A : ASL A : ADC trow : ADC #4 : STA row  ; (C clear)
    LDA bcol : ASL A : ASL A : ADC tcol : STA col
    LDA row : LSR A : LSR A : LSR A : STA p+1               ; row * 32 + col
    LDA row : ASL A : ASL A : ASL A : ASL A : ASL A : ORA col : STA p
    LDA p : CLC : ADC #LO(a24097) : STA q
    LDA p+1 : ADC #HI(a24097) : STA q+1
    LDY #0 : LDA attr : STA (q),Y
    LDA p+1 : CLC : ADC #HI(scen_ink) : STA p+1
    ASSERT LO(scen_ink) = 0
    LDA glyph_ink : STA (p),Y
    \ Its pixels, 34526 + 8 * (base + byte) (in 16 bits, as the original
    \ forms it), written as 54464 writes them, straight into our cell.
    LDA tile : CLC : ADC base : STA p
    LDA base+1 : ADC #0 : STA p+1
    ASL p : ROL p+1 : ASL p : ROL p+1 : ASL p : ROL p+1
    LDA p : CLC : ADC #LO(a34526) : STA p
    LDA p+1 : ADC #HI(a34526) : STA p+1
    LDA col : ASL A : ASL A : ASL A : ASL A : STA q         ; (col AND 15) * 16
    LDA row : ASL A : STA q+1
    LDA col : LSR A : LSR A : LSR A : LSR A : CLC : ADC q+1
    ADC #HI(screen) : STA q+1
    LDA q : ORA #8 : STA q8 : LDA q+1 : STA q8+1
    LDA row : ASL A : ASL A : ASL A : ORA glyph_ink : TAX       ; (row * 8 + ink)
    LDA pat_even,X : STA pe
    LDA pat_odd,X : STA po
    LDY #0
.line
    LDA (p),Y : TAX
    LDA spread_hi,X : AND pe : STA (q),Y
    LDA spread_lo,X : AND pe : STA (q8),Y
    INY
    LDA (p),Y : TAX
    LDA spread_hi,X : AND po : STA (q),Y
    LDA spread_lo,X : AND po : STA (q8),Y
    INY : CPY #8 : BNE line
    INC tcol : LDA tcol : CMP #4 : BEQ done1
    JMP each_tile
    ZA_UNREACHABLE
.done1
    INC trow : LDA trow : CMP #4 : BEQ done2
    JMP tile_row
    ZA_UNREACHABLE
.done2
    INC layout : BNE laid : INC layout+1
.laid
    INC bcol : LDA bcol : CMP #8 : BEQ done3
    JMP each_block
    ZA_UNREACHABLE
.done3
    INC brow : LDA brow : CMP #5 : BEQ done4
    JMP block_row
    ZA_UNREACHABLE
.done4
    RTS
}
ENDSECTION

\ --- The colours (decisions 10 and 11) ---------------------------------------

\ Each row's logical 1-3 as BBC colours: rp1, rp2, rp3 (24 each). The
\ panel's rows are fixed (tools/colours.py's PANEL_ROWS).
.panel_rp2  EQUB 5, 5, 1, 6         ; magenta, magenta, red, cyan
PANEL_RP1 = 3                       ; yellow
PANEL_RP3 = 2                       ; green

SECTION RoomData
\ Room A's colours from its plan (in room_buf, its pack unpacked: ROOMDATA
\ paged in): rows 4-23 from the panel's last, logical 1 yellow, then
\ make_patterns and make_program.
.room_colours
{
    ZA_AUTO2 p
    ZA_AUTO1 nib
    \ p = the plans in room_buf + 10 * the room's place in its pack
    AND #ROOM_PACK - 1 : STA p
    ASL A : ASL A : ADC p : ASL A              ; 10 * (C clear: at most 70)
    CLC : ADC #LO(room_buf + ROOM_PACK * 40) : STA p
    LDA #HI(room_buf + ROOM_PACK * 40) : ADC #0 : STA p+1
    JSR panel_colours
    LDX #4
.row
    LDA #PANEL_RP1 : STA rp1,X
    LDA rp2-1,X : STA rp2,X
    LDA rp3-1,X : STA rp3,X
    TXA : SEC : SBC #4 : LSR A : TAY
    LDA (p),Y
    BCS low
    LSR A : LSR A : LSR A : LSR A
.low
    AND #15 : BEQ next
    STA nib
    AND #7
    LDY nib : CPY #8 : BCS l3
    STA rp2,X
    JMP next
    ZA_UNREACHABLE
.l3
    STA rp3,X
.next
    INX : CPX #SCREEN_ROWS : BNE row
    JSR make_patterns
    JMP make_program
}
ENDSECTION

\ The panel's rows into rp1-3 (rows 0-3).
.panel_colours
{
    LDX #3
.row
    LDA #PANEL_RP1 : STA rp1,X
    LDA panel_rp2,X : STA rp2,X
    LDA #PANEL_RP3 : STA rp3,X
    DEX : BPL row
    RTS
}

\ Colours for a screen that isn't a room: the panel's rows, and below
\ them the panel's last row's (yellow, cyan, green).
.plain_colours
{
    JSR panel_colours
    LDX #4
.row
    LDA rp1+3 : STA rp1,X
    LDA rp2+3 : STA rp2,X
    LDA rp3+3 : STA rp3,X
    INX : CPX #SCREEN_ROWS : BNE row
    JMP make_colours
}

SECTION RoomData
\ The pattern pairs (pat_even, pat_odd at row * 8 + ink) for every row
\ and Spectrum ink, from rp1-3: tools/colours.py's pick. Each pair of
\ logical colours (a, b) scores 4 * the colours it is out from the ink's,
\ and a dither (a <> b) 1 more and 2 for each colour the two share; the
\ lowest wins, the first on a tie. Black, which no lit pixel can be,
\ shows as white.
.pair_a     EQUB 1, 2, 3, 1, 1, 2
.pair_b     EQUB 1, 2, 3, 2, 3, 3
.pop3       EQUB 0, 1, 1, 2, 1, 2, 2, 3
.cb_aa      FOR c = 0..3 : EQUB cbyte(c) AND &AA : NEXT
.cb_55      FOR c = 0..3 : EQUB cbyte(c) AND &55 : NEXT
.zx_to_bbc  EQUB 7, 4, 1, 5, 2, 6, 3, 7     ; (ink 0 as white)

.make_patterns
{
    q = pat_q                       ; q+1..q+3: the row's logical 1-3
    ZA_AUTO1 row
    ZA_AUTO1 ink
    ZA_AUTO1 want
    ZA_AUTO1 best
    ZA_AUTO1 ba
    ZA_AUTO1 bb
    ZA_AUTO1 s
    ZA_AUTO1 j
    LDA #0 : STA row
.each_row
    LDX row
    LDA rp1,X : STA q+1
    LDA rp2,X : STA q+2
    LDA rp3,X : STA q+3
    LDA #0 : STA ink
.each_ink
    LDX ink : LDA zx_to_bbc,X : STA want
    LDA #255 : STA best
    LDA #1 : STA ba : STA bb
    LDA #0 : STA j
.each_pair
    LDX j
    LDY pair_b,X
    LDA pair_a,X : TAX
    LDA q,X : ORA q,Y : EOR want : TAX
    LDA pop3,X : ASL A : ASL A : STA s
    LDX j
    LDA pair_a,X : CMP pair_b,X : BEQ solid
    TAX : LDA q,X : AND q,Y : TAX
    LDA pop3,X : ASL A : SEC : ADC s : STA s    ; + 1 + 2 * shared
.solid
    LDA s : CMP best : BCS worse
    STA best
    LDX j
    LDA pair_a,X : STA ba
    LDA pair_b,X : STA bb
.worse
    INC j : LDA j : CMP #6 : BNE each_pair
    \ a b a b on even lines, b a b a on odd.
    LDA row : ASL A : ASL A : ASL A : ORA ink : TAY
    LDX ba : LDA cb_aa,X : LDX bb : ORA cb_55,X : STA pat_even,Y
    LDX bb : LDA cb_aa,X : LDX ba : ORA cb_55,X : STA pat_odd,Y
    INC ink : LDA ink : CMP #8 : BEQ done5
    JMP each_ink
    ZA_UNREACHABLE
.done5
    INC row : LDA row : CMP #SCREEN_ROWS : BEQ done6
    JMP each_row
    ZA_UNREACHABLE
.done6
    RTS
}
    ASSERT SCREEN_ROWS <= 32        ; (ink * 32 + row)

\ The palette program (pal_prog, irq.6502's set_palette's format) for
\ rp1-3: the VSync palette row 0's; a split at each row boundary for
\ each logical colour that changes there (two at one boundary land two
\ lines apart: the plans never have them). None where nothing changes:
\ VSync's count reaches the first split wherever it is (split_count).
.make_program
{
    ZA_AUTO1 n
    ZA_AUTO1 r
    ZA_AUTO1 line
    ZA_AUTO1 k
    ZA_AUTO2 period
    ZA_AUTO2 base
    LDA #0 : STA pal_prog+1
    LDA rp1 : STA pal_prog+2
    LDA rp2 : STA pal_prog+3
    LDA rp3 : STA pal_prog+4
    LDA #0 : STA n
    LDA #1 : STA r
.boundary
    LDA r : ASL A : ASL A : ASL A : STA line
    LDX r
    LDA rp1,X : CMP rp1-1,X : BEQ not1
    LDY #1 : JSR add
.not1
    LDX r
    LDA rp2,X : CMP rp2-1,X : BEQ not2
    LDY #2 : JSR add
.not2
    LDX r
    LDA rp3,X : CMP rp3-1,X : BEQ not3
    LDY #3 : JSR add
.not3
    INC r : LDA r : CMP #SCREEN_ROWS : BNE boundary
    \ T1: VSync's count to split 0 (split_count), the periods from each
    \ split to the next (t1_period), then none.
    LDA n : STA pal_prog
    ASL A : CLC : ADC #5 : TAY      ; after the pairs
    LDA #0 : STA k
    LDA #FIRST_SPLIT_LINE : STA line
    LDA #LO(SPLIT_FIRST) : STA base : LDA #HI(SPLIT_FIRST) : STA base+1
.periods
    LDX k : CPX n : BCS last
    LDA split_lines,X : SEC : SBC line : STA period  ; the lines since
    LDA split_lines,X : STA line
    LDA #0 : STA period+1
    LDX #6
.times64
    ASL period : ROL period+1
    DEX : BNE times64
    LDA period : CLC : ADC base : STA pal_prog,Y : INY
    LDA period+1 : ADC base+1 : STA pal_prog,Y : INY
    LDA #LO(-2) : STA base : LDA #HI(-2) : STA base+1    ; (t1_period's)
    INC k
    JMP periods
    ZA_UNREACHABLE
.last
    LDA #&FF
    STA pal_prog,Y : INY : STA pal_prog,Y : INY
    STA pal_prog,Y : INY : STA pal_prog,Y
    RTS
\ A split at line (moved on 2 for each one already there): logical Y,
\ colour A.
.add
    LDX n : CPX #MAX_SPLITS : BCS full
    PHA
    LDA line : STA split_lines,X
    INC line : INC line
    TXA : ASL A : TAX
    TYA : STA pal_prog+5,X
    PLA : STA pal_prog+6,X
    INC n
.full
    RTS
}
    ASSERT MAX_SPLITS * 2 + 5 + 2 * (MAX_SPLITS + 2) <= PAL_PROG_LEN
ENDSECTION

\ --- The panel -----------------------------------------------------------

\ 53550, DrawPanel: six lives (frame 1 at 58796's places), the
\ attributes of rows 0-3 to 70, SCORE, MAGIC, the witches' faces, the
\ score and magic, the mouths at rest (53823). The attributes are set
\ before the lives here, not after: a frame without colour takes its
\ cell's (decision 10), which the original's attributes give it after;
\ the lives' frame XORs no attribute, so the attributes end the same.
.z53550
{
    ZA_AUTO1 n
    \ The panel's colours first: its pixels take their logical colours
    \ from the rows' palettes as they're drawn (the front end's may show).
    JSR plain_colours
    LDA #6 : STA a24035
    LDX #127
.attr
    LDA #70 : STA attrs,X
    LDA #6 : STA scen_ink,X
    DEX : BPL attr
    LDA #LO(a58796) : STA rixl : LDA #HI(a58796) : STA rixh
    LDY #0 : LDA (rix),Y : STA rd
    INC rixl : BNE l1 : INC rixh
.l1
    LDA #6 : STA n
.life
    LDY #0 : LDA (rix),Y : STA re
    LDA #LO(a24225) : STA rl : LDA #HI(a24225) : STA rh
    LDA #1 : JSR z57415
    JSR z57194
    INC rixl : BNE l2 : INC rixh
.l2
    DEC n : BNE life
    LDA #0 : STA rb : LDA #13 : STA rc
    LDA #LO(a58032) : STA rl : LDA #HI(a58032) : STA rh : JSR z54363
    LDA #2 : STA rb : LDA #13 : STA rc
    LDA #LO(a58039) : STA rl : LDA #HI(a58039) : STA rh : JSR z54363
    LDA #0 : STA rb : STA rc
    LDA #LO(a61162) : STA rl : LDA #HI(a61162) : STA rh : JSR z54363
    LDA #LO(a58835) : STA re : LDA #HI(a58835) : STA rd
    JSR z57616
    LDA #LO(a58835) : STA re : LDA #HI(a58835) : STA rd
    JSR z57568
    LDA #0 : STA rb : LDA #28 : STA rc
    LDA #LO(a61189) : STA rl : LDA #HI(a61189) : STA rh : JSR z54363
    LDA #53
    JMP z53823
}

\ 53823, DrawHeadEyes: XOR frame A on the left head (x 4, y 13) and A + 3
\ on the right (x 112), through 57194. A kept.
.z53823
{
    ZA_AUTO1 frame
    ZA_AUTO1 lines
    ZA_AUTO1 width
    STA frame
    LDA #4 : STA re : LDA #13 : STA rd
    LDA #LO(a24225) : STA rl : LDA #HI(a24225) : STA rh
    LDA frame : JSR preshift_pair  ; (57415)
    LDA rb : STA lines : LDA rc : STA width
    LDA #LO(a24427) : STA rl : LDA #HI(a24427) : STA rh
    LDA #112 : STA re
    LDA frame : CLC : ADC #3
    JSR z57415
    JSR z57194
    LDA lines : STA rb : LDA width : STA rc
    LDA #LO(a24225) : STA rl : LDA #HI(a24225) : STA rh
    LDA #4 : STA re
    LDA frame
    JMP z57194
}

\ --- The viewer and the demo -----------------------------------------------

IF DEFINED(VIEWER)
\ The viewer (-D VIEWER=1, make rooms): the panel, then room view_num
\ drawn through 53949's drawing (54213, then 53979-54151) each time it
\ changes; tools/roomcheck.mjs sets it and runs to viewer_wait.
.viewer
    \ The score and magic as a new game has them (53858).
    LDX #6 : LDA #'0'
.digits
    STA a58804,X
    DEX : BPL digits
    LDA #'9' : STA a58813 : STA a58814
    LDA #&FF : STA view_shown
    LDA #0 : STA test_n
.viewer_wait
    LDA test_n : BNE tests
    LDA view_num : CMP view_shown : BEQ viewer_wait
    STA view_shown
    JSR z53087                      ; (the panel afresh too: the sprite tests draw on it)
    JSR z53550
    JSR z54213
    LDA view_num : STA a24030
    JSR room_scenery
    JMP viewer_wait
    ZA_UNREACHABLE
\ tools/spritecheck.mjs's calls (test_calls, test_n of them, 6 bytes
\ each: frame, x, y, slot, erase, kind): each pre-shifts the frame into
\ 24225 (57415) and XORs it with slot (24022) and xor_erase as given,
\ through 57058 (kind 0) or straight through 57194 (kind 1).
.tests
{
    ZA_AUTO1 i
    ZA_AUTO1 kind
    LDA #0 : STA i
.call
    LDA i : ASL A : ADC i : ASL A : TAX          ; (6i: C clear)
    LDA test_calls+3,X : STA a24022
    LDA test_calls+4,X : STA xor_erase
    LDA test_calls+1,X : STA re
    LDA test_calls+2,X : STA rd
    LDA test_calls+5,X : STA kind
    LDA #LO(a24225) : STA rl : LDA #HI(a24225) : STA rh
    LDA test_calls,X
    JSR z57415
    LDX kind : BNE direct
    JSR z57058
    JMP next
    ZA_UNREACHABLE
.direct
    JSR z57194
.next
    INC i : LDA i : CMP test_n : BNE call
    LDA #0 : STA test_n
}
.test_done
    JMP viewer_wait
ENDIF

IF DEFINED(DEMO_ROOM)
\ Until the game is written (game.6502's 52180): the panel and room 97,
\ to see the drawing on the release disc.
.demo
    JSR z53087
    JSR z53550
    JSR z54213
    LDA #97 : STA a24030
    JSR room_scenery
.demo_shown
    JMP demo_shown
ENDIF
