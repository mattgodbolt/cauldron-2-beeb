\ ***************************************************************************
\ Drawing: sprites (pre-shift and XOR, 57058-57415), text (54363, 54464),
\ CLS and line clearing (53087, 53931), the screen and attribute address
\ helpers (57307, 57326, 57341).
\
\ The screen keeps exactly the original's lit pixels; their colour is the
\ port's (decisions 5 and 10). Each character row r has a pattern pair for
\ each Spectrum ink k (make_patterns, room.6502): pat_even and pat_odd at
\ k * 32 + r, a MODE 1 byte of four pixels' logical colours for the
\ row's even and odd lines, solid or an ordered dither. A lit pixel's
\ colour is its ink's pattern ANDed with the pixel:
\
\ - scenery (54464, LD to the screen): the cell's ink (glyph_ink), which
\   scen_ink keeps per cell, as the attribute file had it before any
\   sprite XORed colour into it;
\ - a sprite's XOR (xor_zx): a pixel the XOR lights takes spr_ink, the
\   sprite's colour, or with spr_ink negative the cell's scen_ink; a lit
\   pixel the XOR leaves lit keeps its colour; one it clears is black.
\
\ A sprite drawn (xor_erase 0) is in its own colour (sprite_ink): the
\ colour the original shows its frame in over the room's empty cells
\ (attribute 70: its frame attribute EOR 70); a frame without one
\ (60422 = 0) the pumpkin's yellow in slot 0, else its cell's scenery
\ ink, as the original shows it. A sprite erased (xor_erase non-zero:
\ the mover's XOR of the old image) relights the scenery under it in the
\ scenery's colour. xor_erase applies to one call of 57058 or 57194 and
\ is clear again after it.
\ ***************************************************************************

\ The spread tables and the lit-pixel mask: a Spectrum byte's left four
\ pixels as a MODE 1 byte, all of each lit pixel's bits set (spread_hi),
\ its right four (spread_lo); a MODE 1 byte's unlit pixels the same way
\ (unlit). After init_zxscreen (lit_lo).
.init_draw
{
    LDX #0
.each
    TXA : AND #&F0 : STA spread_hi,X
    TXA : LSR A : LSR A : LSR A : LSR A : ORA spread_hi,X : STA spread_hi,X
    TXA : AND #&0F : STA spread_lo,X
    ASL A : ASL A : ASL A : ASL A : ORA spread_lo,X : STA spread_lo,X
    LDA lit_lo,X : ASL A : ASL A : ASL A : ASL A : ORA lit_lo,X : EOR #&FF : STA unlit,X
    TXA : LSR A : LSR A : LSR A : LSR A : STA sh_hi4,X
    LSR A : LSR A : STA sh_hi6,X
    INX : BNE each
    STX xor_erase                   ; (0)
    STX ps_pend
    RTS
}

\ --- One Spectrum byte ---------------------------------------------------

ZA_AUTO1 spr_ink                ; the sprite's colour, a Spectrum ink; negative: the cell's
ZA_AUTO1 pat                    ; the pattern of the byte being written

\ Our address of the Spectrum screen byte X (low), Y (high) into zx_ptr,
\ and the pattern of ink A for its row and line into pat. Y kept.
.zx_cell
{
    ZA_AUTO1 idx
    STA idx
    TYA : AND #7 : ORA zx_lo,X : STA zx_ptr
    TYA : AND #&18 : ASL A : ADC zx_hi,X : STA zx_ptr+1 ; (C clear: AND #&18, ASL)
    TXA : LSR A : LSR A : AND #&38 : ORA idx : STA idx  ; + the character row * 8
    TYA : AND #&18 : ASL A : ASL A : ASL A : ORA idx : TAX
    TYA : LSR A : BCS odd
    LDA pat_even,X : STA pat
    RTS
.odd
    LDA pat_odd,X : STA pat
    RTS
}
ZA_AUTO1 scen_y

\ The sprite routines read GAMEDATA's tables (60422, 59798, the frames,
\ the line table 58931), so they only run with it paged in; most of them
\ live there, as main RAM is full (decision 17).
SECTION GameData

ZA_AUTO2 xr_img                 ; xor_lines' image: its first line's bytes
ZA_AUTO1 xr_n                   ; ... how many a line (1-255)
ZA_AUTO1 xr_step                ; ... from one line's first to the next's
ZA_AUTO1 xr_lines               ; ... and its lines (0 is 256)

\ xor_lines: XOR xr_lines lines of xr_n bytes, from xr_img (each line
\ xr_step on from the one before), onto the Spectrum screen from X
\ (low), Y (high), coloured as the head of the file says (spr_ink):
\ along a line as the original's INC HL steps, each line the next down
\ as it steps its lines (INC H; past a character row, L + 32 and H back
\ a third unless that carried). An address in the attribute file XORs
\ the attribute, as the original's would. xr_img ends past the lines.
\ A, X, Y changed.
\
\ A line's bytes along a cell row are ours 16 apart, on one character row
\ and line, and a character row's lines are ours one apart; so a run on
\ one cell row goes a character row's lines at a time (xor_seg). A run
\ that leaves its cell row, or meets the attributes, goes a line at a
\ time (xor_line).
.xor_lines
{
    ZA_AUTO1 bx                     ; the line's Spectrum address
    ZA_AUTO1 by
    STX bx : STY by
.block
    \ xs_nb: the lines left in the character row, at most xr_lines.
    TYA : AND #7 : EOR #7 : CLC : ADC #1         ; 8 - (y AND 7)
    LDX xr_lines : BEQ lines_ok                 ; (0: 256)
    CMP xr_lines : BCC lines_ok
    TXA
.lines_ok
    STA xs_nb
    \ As a block: the run on one cell row, off the attributes, and its
    \ lines' bytes in X's reach (xor_seg).
    CPY #&58 : BCS alone
    LDA bx : ORA #&E0 : EOR #&FF                ; 31 - x
    CLC : ADC #1 : CMP xr_n : BCC alone         ; (32 - x bytes on the row)
    LDA xr_step : CMP #32 : BCS alone
    LDA xr_img : STA xs_img : LDA xr_img+1 : STA xs_img+1
    LDA xr_n : STA xs_n
    LDX bx : JSR xor_seg                        ; (Y = by)
    JMP done_lines
.alone
    LDA #1 : STA xs_nb
    JSR xor_line
.done_lines
    \ Past them: the image, xs_nb * xr_step on (xs_span); the address,
    \ the next line down.
    LDA xr_img : CLC : ADC xs_span : STA xr_img
    BCC stepped : INC xr_img+1
.stepped
    LDA xr_lines : SEC : SBC xs_nb : STA xr_lines : BEQ done
    LDA by : CLC : ADC xs_nb : STA by
    AND #7 : BNE same_row
    LDA bx : CLC : ADC #32 : STA bx
    BCS same_row
    LDA by : SEC : SBC #8 : STA by
.same_row
    LDY by
    JMP block
.done
    RTS
}

\ One line of xor_lines' run, from its bx, by, a byte at a time (the
\ rare run that leaves its cell row or meets the attributes): each byte
\ on the screen a block of one byte and one line, an attribute XORed.
.xor_line
{
    ZA_AUTO1 left
    ZA_AUTO1 lx
    ZA_AUTO1 hy
    LDA xr_img : STA xs_img : LDA xr_img+1 : STA xs_img+1
    LDA xr_n : STA left
    LDA xr_step : STA xs_span       ; (and xor_seg's, of one line)
    LDA #1 : STA xs_n
    LDX xor_lines.bx : LDY xor_lines.by
.each
    STX lx : STY hy
    CPY #&58 : BCS attr
    JSR xor_seg
    JMP next
.attr
    CPY #&5B : BCS next             ; (past the attributes: not the port's)
    STX zx_ptr
    TYA : ADC #ATTR_HI : STA zx_ptr+1                   ; (C clear: CPY, BCS)
    LDY #0 : LDA (xs_img),Y : EOR (zx_ptr),Y : STA (zx_ptr),Y
.next
    INC xs_img : BNE imged : INC xs_img+1
.imged
    LDX lx : LDY hy
    INX : BNE same : INY
.same
    DEC left : BNE each
    RTS
}

ZA_AUTO2 xs_img                 ; xor_seg's image: the first line's first byte
ZA_AUTO1 xs_n                   ; ... its bytes a line (1-32, on one cell row)
ZA_AUTO1 xs_nb                  ; ... its lines (1-8, in one character row)
ZA_AUTO1 xs_span                ; ... and on: xs_nb * xr_step

\ xor_seg: xs_nb lines of xs_n bytes from xs_img (lines xr_step apart),
\ from X (low), Y (high), a run on one cell row and one character row's
\ lines. (xs_nb - 1) * xr_step + xs_n is at most 255.
\
\ It goes a sub-run at a time: the bytes whose cells share an ink (with
\ spr_ink not negative, all of them), at most 15. Each line's bytes go
\ last first, X the byte's index in the image + 1 and Y 16 * its byte
\ in the sub-run + its line, so that Y's borrow ends the line; the
\ image and the spread tables are operands set for the sub-run and the
\ byte. The pattern (pt) is the sub-run's ink's for the line: pd turns
\ it into the other line's.
.xor_seg
{
    ZA_AUTO2 sp                     ; the scenery inks of the run's cell on
    ZA_AUTO2 bl                     ; our address of the sub-run's first byte, its left four pixels
    ZA_AUTO2 br                     ; ... and its right four
    ZA_AUTO1 r8
    ZA_AUTO1 i0
    ZA_AUTO1 i1
    ZA_AUTO1 lim
    ZA_AUTO1 ink
    ZA_AUTO1 pt
    ZA_AUTO1 pd
    ZA_AUTO1 sv
    ZA_AUTO1 old
    STX sp
    TYA : AND #7 : ORA zx_lo,X : STA bl : ORA #8 : STA br
    TYA : AND #&18 : ASL A : ADC zx_hi,X : STA bl+1 : STA br+1 ; (C clear: AND #&18, ASL)
    TYA : LSR A : LSR A : LSR A : AND #3 : CLC : ADC #HI(scen_ink) : STA sp+1
    TXA : LSR A : LSR A : AND #&38 : STA r8             ; the character row * 8
    TYA : AND #&18 : ASL A : ASL A : ASL A : ORA r8 : STA r8
    LDA xs_img : SEC : SBC #1 : STA img_op+1            ; (X: the index + 1)
    LDA xs_img+1 : SBC #0 : STA img_op+2
    LDA xs_nb : CLC : ADC #239 : STA end_op+1           ; (Y past the last line)
    LDY #0
.sub
    \ The sub-run: i0 (Y) up to i1.
    STY i0
    TYA : CLC : ADC #15 : CMP xs_n : BCC capped
    LDA xs_n
.capped
    STA lim
    LDA spr_ink : BPL own
    LDA (sp),Y : STA ink
.same
    INY : CPY lim : BEQ got
    LDA (sp),Y : CMP ink : BEQ same
    BNE got                         ; (always)
.own
    STA ink
    LDY lim
.got
    STY i1
    \ Its patterns: pat_even or pat_odd (odd y) + the row * 8 + the ink.
    LDA ink : CLC : ADC r8 : TAX
    LDA pat_even,X : EOR pat_odd,X : STA pd
    LDA bl : LSR A                  ; (C: the line's odd)
    LDA pat_even,X
    BCC first
    LDA pat_odd,X
.first
    STA pt
    \ The loop's steps: the next line's last byte, X + (i1 - i0) +
    \ xr_step; Y from 16 * 0 + k - 16 to 16 * (i1 - i0 - 1) + k + 1.
    LDA i1 : SEC : SBC i0 : TAX
    CLC : ADC xr_step : STA dx_op+1
    DEX : TXA : ASL A : ASL A : ASL A : ASL A : TAY     ; 16 * (i1 - i0 - 1)
    CLC : ADC #17 : STA dy_op+1
    LDX i1
    SEC
.cell
    \ Each half of each byte: a pixel the XOR lights takes pt if unlit,
    \ goes black if lit; the others stay. All unlit (most often), that's
    \ the XOR's pixels AND pt; else (mixed: an erase's, mostly)
    \ new = old EOR (the XOR's AND (old OR (pt AND unlit))). A half with
    \ nothing to XOR is left. C stays set until the line's end.
.img_op
    LDA &FFFF,X : BEQ next          ; (nothing to XOR)
    STA hi_op+1 : STA lo_op+1
.hi_op
    LDA spread_hi : BEQ right
    STA sv
    LDA (bl),Y : BNE mix_l
    LDA sv : AND pt : STA (bl),Y
.right
.lo_op
    LDA spread_lo : BEQ next
    STA sv
    LDA (br),Y : BNE mix_r
    LDA sv : AND pt : STA (br),Y
.next
    DEX
    TYA : SBC #16 : TAY : BCS cell
    \ The line's done (C clear, Y below end_op's): the next.
.end_op
    CPY #0 : BEQ sub_done
    TXA
.dx_op
    ADC #0 : TAX
    TYA
.dy_op
    ADC #0 : TAY
    LDA pt : EOR pd : STA pt
    SEC
    BCS cell                        ; (always)
.mix_l
    STA old : STA ul_l+1
.ul_l
    LDA unlit : AND pt : ORA old : AND sv : EOR old
    STA (bl),Y
    JMP right
.mix_r
    STA old : STA ul_r+1
.ul_r
    LDA unlit : AND pt : ORA old : AND sv : EOR old
    STA (br),Y
    JMP next
.sub_done
    LDY i1 : CPY xs_n : BCS seg_done
    \ The next sub-run's screen bytes: 16 * (i1 - i0) on (dy_op's - 1).
    LDX dy_op+1 : DEX : TXA
    CLC : ADC bl : STA bl : ORA #8 : STA br             ; (bl's low nibble is the line)
    BCC sub_bl
    INC bl+1 : INC br+1
.sub_bl
    JMP sub
.seg_done
    \ X: the last line's first byte's index.
    TXA : SEC : SBC i0 : CLC : ADC xr_step : STA xs_span
    RTS
}
    ASSERT LO(spread_hi) = 0 AND LO(spread_lo) = 0 AND LO(unlit) = 0   ; (operands' low bytes)
ENDSECTION


\ Write the Spectrum byte A to the Spectrum screen at X (low), Y (high),
\ as LD (HL),A does, in ink glyph_ink, which becomes the cell's scenery
\ ink. A, X, Y changed.
.put_zx
{
    ZA_AUTO1 bits
    ZA_AUTO2 p
    STA bits
    CPY #&58 : BCS attr
    STX p                           ; the cell's scenery ink
    TYA : LSR A : LSR A : LSR A : AND #3 : CLC : ADC #HI(scen_ink) : STA p+1
    STY scen_y
    LDY #0 : LDA glyph_ink : STA (p),Y
    LDY scen_y
    LDA glyph_ink : JSR zx_cell
    LDY #0
    LDX bits : LDA spread_hi,X : AND pat : STA (zx_ptr),Y
    LDY #8
    LDA spread_lo,X : AND pat : STA (zx_ptr),Y
    RTS
.attr
    CPY #&5B : BCS none             ; (past the attributes: not the port's)
    STX zx_ptr
    TYA : CLC : ADC #ATTR_HI : STA zx_ptr+1
    LDY #0 : LDA bits : STA (zx_ptr),Y
.none
    RTS
}

SECTION GameData                    ; (as xor_lines)

\ spr_ink for frame A (decision 10): the scenery's when erasing, else the
\ frame's colour over an empty cell, else (no colour) the pumpkin's
\ yellow when X = 0 (slot 0), else the scenery's. A kept.
.sprite_ink
{
    PHA
    LDY xor_erase : BNE scenery
    TAY : LDA a60422,Y : BEQ none
    EOR #70 : AND #7 : STA spr_ink
    PLA
    RTS
.none
    TXA : BNE scenery
    LDA #6 : STA spr_ink
    PLA
    RTS
.scenery
    LDA #&FF : STA spr_ink
    PLA
    RTS
}

\ --- Sprites -------------------------------------------------------------

\ 57058, DrawObject: XOR the pre-shifted image at HL (B lines of C bytes)
\ for frame A at D = y, E = x. Slots 0 and 1 (24022) clipped and
\ colourless (57074), the others through 57182.
.z57058
    PHA
    LDA a24022 : CMP #2 : BCS z57058_on
    JMP z57074
.z57058_on
    PLA
    JMP z57182
ENDSECTION

\ The clipped draw: at the sides by a skip count (24038) and a limit
\ (24039), above and below by the line table 58931, whose lines off the
\ play area all point at a sink (24995: the BBC's address, below the
\ screen, so a byte there is plain memory). O: B = 0; HL = the line
\ table's entry after the last line; A, C, DE, IX kept.
.z57074
{
    ZA_AUTO2 img
    ZA_AUTO2 line
    ZA_AUTO1 col
    ZA_AUTO1 skip
    ZA_AUTO1 lim
    ZA_AUTO1 first
    ZA_AUTO1 cnt
    ZA_AUTO1 n
    ZA_AUTO1 k
    ZA_AUTO1 frame
    PLA : STA frame
    LDX a24022 : JSR sprite_ink
    LDA rl : STA img : LDA rh : STA img+1       ; (the original pops HL into IX)
    LDA #0 : STA a24038
    ORA #128 : STA a24039
    LDA re : LSR A : LSR A
    SEC : SBC #3 : BCS right                    ; (Z80 SUB 3, NC)
    EOR #&FF : CLC : ADC #1 : STA a24038         ; the bytes off the left
    LDA #0
    JMP got
    ZA_UNREACHABLE
.right
    PHA
    CLC : ADC rc : SEC : SBC #32 : BCC on        ; (Z80 C: it ends on the screen)
    STA n
    LDA rc : SEC : SBC n : STA a24039            ; the bytes up to the right edge
.on
    PLA
.got
    AND #31 : STA col
    \ HL = 58931 + 2 * y.
    LDA rd : ASL A : STA rl
    LDA #0 : ROL A : STA rh
    LDA rl : CLC : ADC #LO(a58931) : STA rl
    LDA rh : ADC #HI(a58931) : STA rh
    \ Every line draws the same bytes, a run: as the original's count
    \ down picks them (DEC E : JP P, still skipping; DEC D : JP M, past
    \ the limit), the first (first) and how many (cnt).
    LDA a24038 : STA skip
    LDA a24039 : STA lim
    LDY #0 : STY cnt
.pick
    DEC skip : BPL picked
    DEC lim : BMI picked
    LDA cnt : BNE more
    STY first
.more
    INC cnt
.picked
    INY : CPY rc : BNE pick
    LDA rb : STA n
    LDA rc : STA xr_step
.each_line
    LDA #1 : STA k                  ; (the lines this time round)
    LDA cnt : BEQ line_done
    STA xr_n
    LDA img : CLC : ADC first : STA xr_img
    LDA img+1 : ADC #0 : STA xr_img+1
    LDY #0 : LDA (rl),Y : CLC : ADC col : TAX
    INY : LDA (rl),Y : ADC #0 : TAY
    CPY #&40 : BCS on_screen
    STX line : STY line+1           ; the sink: plain memory
    LDY #0
.sink
    LDA (xr_img),Y : EOR (line),Y : STA (line),Y
    INY : CPY cnt : BNE sink
    BEQ line_done                   ; (always)
.on_screen
    \ The play area's entries (58931's lines 32-191) are the Spectrum's
    \ lines one below another, as xor_lines steps them: the rest of them
    \ (192 - the line, at most n) go in one call.
    LDA #LO(a58931 + 2 * 192) : SEC : SBC rl : STA k
    LDA #HI(a58931 + 2 * 192) : SBC rh
    BCC single                      ; (past them)
    LSR A : ROR k
    LDA k : BEQ single : CMP #161 : BCS single  ; (before them)
    LDA n : BEQ batch               ; (0: 256 lines)
    CMP k : BCS batch
    STA k
    BCC batch                       ; (always)
.single
    LDA #1 : STA k
.batch
    LDA k : STA xr_lines
    JSR xor_lines
.line_done
    LDA img : CLC : ADC rc : STA img
    BCC imged : INC img+1
.imged
    LDA rl : CLC : ADC #2 : STA rl
    BCC same : INC rh
.same
    DEC n : BEQ lines_done
    DEC k : BNE line_done
    JMP each_line
.lines_done
    LDA #0 : STA rb : STA xor_erase
    LDA frame
    RTS
}

SECTION GameData

\ 57182: E - 12, then 57194.
.z57182
{
    PHA
    LDA re : PHA
    SEC : SBC #12 : STA re
    TSX : LDA &0102,X                            ; (A, under E on the stack)
    JSR z57194
    PLA : STA re
    PLA
    RTS
}

\ 57194, DrawSpriteAttr: XOR the image at HL (B lines of C bytes) at
\ D = y, E / 4 = the byte column, unclipped, down the Spectrum's lines as
\ its screen addresses go; then frame A's attribute (60422, if not 0)
\ XORed onto C cells by B / 8 rounded up rows from the top line's cell.
\ Every register kept.
.z57194
{
    ZA_AUTO2 src
    ZA_AUTO2 scr                    ; the line's first byte (the Spectrum's address)
    ZA_AUTO2 at                     ; the row's first attribute
    ZA_AUTO1 left
    ZA_AUTO2 top                    ; the top line's first byte
    ZA_AUTO1 lines
    ZA_AUTO1 n
    ZA_AUTO1 frame
    STA frame
    LDX #1 : JSR sprite_ink         ; (X = 1: not the pumpkin's slot)
    LDA rl : STA xr_img : LDA rh : STA xr_img+1
    LDA rd : JSR line_addr          ; X, Y = the line's column 0
    STX scr
    LDA re : LSR A : LSR A : AND #31
    CLC : ADC scr : STA scr : STA top
    TYA : ADC #0 : STA scr+1 : STA top+1
    LDA rb : STA xr_lines
    LDA rc : STA xr_n : STA xr_step
    LDX scr : LDY scr+1 : JSR xor_lines
    \ The colour: 88 + the third, and the top line's low byte.
    LDY frame : LDA a60422,Y : BEQ done
    STA n
    LDA top+1 : LSR A : LSR A : LSR A : AND #7 : ORA #88 : STA at+1
    LDA top : STA at
    LDA rb : LSR A : LSR A : LSR A : STA lines
    LDA rb : AND #7 : BEQ rows
    INC lines
.rows
    LDA lines : BEQ done            ; (no lines: none; the original's DJNZ isn't met with 0)
.each_row
    \ A row's C cells (0: 256) from at, but none past the attributes
    \ (not the port's), nor are the rows below.
    LDA at+1 : CMP #&5B : BCS done
    ADC #ATTR_HI : STA src+1                    ; (C clear: BCS)
    LDA at : STA src
    LDX rc : DEX                                ; the cells - 1
    LDA at+1 : CMP #&5A : BNE count
    LDA at : EOR #&FF : STA left                ; the attributes' cells left - 1
    CPX left : BCC count
    TAX
.count
    INX
    LDY #0
.cell
    LDA (src),Y : EOR n : STA (src),Y
    INY : DEX : BNE cell
    LDA at : CLC : ADC #32 : STA at
    BCC rowed : INC at+1
.rowed
    DEC lines : BNE each_row
.done
    LDA #0 : STA xor_erase
    LDA frame
    RTS
}
ENDSECTION

\ X (low), Y (high) = the Spectrum screen address of line A's column 0,
\ from the character-row table 58883, as 57307 makes it. A kept.
.line_addr
{
    ZA_AUTO1 hi
    PHA
    LSR A : LSR A : LSR A : ASL A : TAY
    LDA a58883,Y : TAX
    LDA a58883+1,Y : STA hi
    PLA : PHA
    AND #7 : CLC : ADC hi : TAY
    PLA
    RTS
}

\ 57307, LineAddr: HL = the screen address of line A. A kept.
.z57307
    JSR line_addr
    STX rl : STY rh
    RTS

\ 57326, AttrUnder: A = the attribute under screen address HL; DE = its
\ address (the original's: its high byte + ATTR_HI is ours).
.z57326
{
    ZA_AUTO2 p
    LDA rh : LSR A : LSR A : LSR A : AND #7 : ORA #88 : STA rd
    LDA rl : STA re : STA p
    LDA rd : CLC : ADC #ATTR_HI : STA p+1
    LDY #0 : LDA (p),Y
    RTS
}

\ 57341, AttrAddr: HL = DE + the cell offset of screen address HL (its
\ third * 256 + its low byte). A kept.
.z57341
{
    PHA
    LDA rh : LSR A : LSR A : LSR A : AND #7 : STA rh
    LDA rl : CLC : ADC re : STA rl
    LDA rh : ADC rd : STA rh
    PLA
    RTS
}

\ 57415, PreShift: frame A's image into the buffer at HL, each line
\ followed by a zero byte, shifted right by 2 * (E - 12) AND 7 pixels as
\ one bit stream from HL - 2 (the two bytes before it zeroed). The
\ original runs the stream through the stack (POP HL : RR L : RR H : PUSH
\ HL), a word at a time, over (B * (C + 1)) AND 255, halved signed,
\ rounded up, plus one, words: here the same bytes, the same count, and
\ the carry running on from one pass into the next as there. O: B = the
\ lines, C = the width + 1; A, DE, HL kept.
\
\ k passes of the stream and its carry, the carry clear at the start
\ (AND A) and running on from each pass's end into the next's start, turn
\ the stream and the carry as one ring of 16 * words + 1 bits right by k.
\ So in one pass: each byte takes the low k bits of the byte before it,
\ and the first byte the last byte's low k - 1 bits and then a zero (the
\ carry), as if the byte before it were the last byte ASLed.
\
\ When the stream covers the whole buffer (B * (C + 1) below 256, and
\ the words enough), the image is shifted as it's copied, and then the
\ stream's bytes past the buffer (the tail) in place; else the image is
\ copied, then the whole stream shifted in place.
\
\ preshift_pair: 57415 into 24225, the next call 57415 into 24427, which
\ shifts this call's tail (flush, decision 19).

\ The fused copy's line end, its zero written: Y on past it, and the
\ loop's source operand (src) one back, so that it + Y is still the
\ frame's next byte; le the next line's end; X = 0, the byte before the
\ next line's first; on to the next line (loop) if there is one.
MACRO PS_LINE_END src, loop, w, le, lines
    INY
    LDA src+1 : BNE ps_lo
    DEC src+2
.ps_lo
    DEC src+1
    TYA : CLC : ADC w : STA le
    LDX #0
    DEC lines : BNE loop
ENDMACRO

.preshift_pair
    LDX #&80
    BITABS
.z57415
{
    LDX #0
    ZA_AUTO2 p                      ; the in-place shift's
    ZA_AUTO2 q                      ; the copy's
    ZA_AUTO2 gfx
    ZA_AUTO2 at
    ZA_AUTO1 w
    ZA_AUTO1 lines
    ZA_AUTO1 m
    ZA_AUTO1 tl                     ; the tail's bytes - 1 (16 bits; -1: none)
    ZA_AUTO1 th
    ZA_AUTO1 k
    ZA_AUTO1 pages
    ZA_AUTO1 t
    ZA_AUTO1 yy
    ZA_AUTO1 frame
    ZA_AUTO1 le
    ZA_AUTO1 defer                  ; negative: preshift_pair's call
    STX defer
    STA frame
    \ The frame's width, height and graphics: 59798 + 4A.
    LDX #0 : STX gfx+1
    ASL A : ROL gfx+1 : ASL A : ROL gfx+1
    ADC #LO(a59798) : STA gfx       ; (C clear: gfx+1 was below 64)
    LDA gfx+1 : ADC #HI(a59798) : STA gfx+1
    LDY #0 : LDA (gfx),Y : STA w : STA rc
    INY : LDA (gfx),Y : STA rb
    INY : LDA (gfx),Y : TAX
    INY : LDA (gfx),Y : STA gfx+1 : STX gfx
    LDA ps_pend : BEQ no_pend
    JSR flush
.no_pend
    \ The two bytes before the buffer, and 24052 = HL - 2.
    LDA rl : SEC : SBC #2 : STA q : STA a24052
    LDA rh : SBC #0 : STA q+1 : STA a24052+1
    LDA #0 : TAY : STA (q),Y : INY : STA (q),Y
    \ The shift: 2 * (x - 12) AND 7 pixels, k.
    LDA re : SEC : SBC #12 : ASL A : AND #7 : STA k
    BNE shift
    JSR copy                        ; (none: the copy is all)
    JMP done
    ZA_UNREACHABLE
.shift
    \ m = (h * (w + 1)) AND 255; Y <> 0 if it carried.
    JSR size
    STA m
    \ The words, m SRA + its carry + 1 (0 is 256), make the tail's bytes
    \ - 1, 2 * words - m - 3: -1 (none) for m even below 128, 255 for m
    \ even from 128, one more for m odd; but m = 255 has 1 word, so a
    \ stream short of the buffer.
    CPY #0 : BNE to_stream
    CMP #255 : BNE tail_size
.to_stream
    JMP stream
    ZA_UNREACHABLE
.tail_size
    LDX #&FF : TAY : BPL below : INX
.below
    LSR A
    LDA #&FF : ADC #0 : STA tl
    TXA : ADC #0 : STA th
    \ The stream's last byte: the tail's last, or with no tail the last
    \ line's zero. The first byte is it ASLed, << 8 - k; the second
    \ stays 0.
    LDA #0
    LDX th : BMI no_tail
    LDA rl : CLC : ADC m : STA p
    LDA rh : ADC #0 : STA p+1
    LDA tl : JSR walk
    STY yy
.no_tail
    LDX k
.first
    ASL A
    INX : CPX #9 : BNE first
    LDY #0 : STA (q),Y              ; (q = HL - 2)
    LDX #0                          ; (the byte before HL: 0)
    JSR start_lines : BNE fused
    JMP tail
    ZA_UNREACHABLE
.fused
    \ Each byte of the frame shifted: its own bits >> k (sh_hi4/6, or shifted) and
    \ the byte before's low k bits on top, from X, the byte before (0 at
    \ a line's start, as the line's zero before it). Y: the byte in the
    \ buffer from q, and the frame's from the source operand, one back
    \ at each line's end (PS_LINE_END); le: Y at the line's end.
    LDA w : STA le
    LDA k : CMP #4 : BEQ f4 : BCS f6
    JMP f2
    ZA_UNREACHABLE
.f6
    LDA gfx : STA f6_src+1 : LDA gfx+1 : STA f6_src+2
    LDA q : STA f6_dst+1 : STA f6_end+1
    LDA q+1 : STA f6_dst+2 : STA f6_end+2
.f6_byte
    TXA : ASL A : ASL A
    CPY le : BEQ f6_end
.f6_src
    LDX &FFFF,Y
    ORA sh_hi6,X
.f6_dst
    STA &FFFF,Y
    INY : BNE f6_byte               ; (always: Y is below h * (w + 1))
.f6_end
    STA &FFFF,Y                     ; (the line's zero)
    PS_LINE_END f6_src, f6_byte, w, le, lines
    JMP tail
    ZA_UNREACHABLE
.f4
    LDA gfx : STA f4_src+1 : LDA gfx+1 : STA f4_src+2
    LDA q : STA f4_dst+1 : STA f4_end+1
    LDA q+1 : STA f4_dst+2 : STA f4_end+2
.f4_byte
    TXA : ASL A : ASL A : ASL A : ASL A
    CPY le : BEQ f4_end
.f4_src
    LDX &FFFF,Y
    ORA sh_hi4,X
.f4_dst
    STA &FFFF,Y
    INY : BNE f4_byte               ; (always)
.f4_end
    STA &FFFF,Y
    PS_LINE_END f4_src, f4_byte, w, le, lines
    JMP tail
    ZA_UNREACHABLE
.f2
    LDA gfx : STA f2_src+1 : LDA gfx+1 : STA f2_src+2
    LDA q : STA f2_dst+1 : STA f2_end+1
    LDA q+1 : STA f2_dst+2 : STA f2_end+2
.f2_byte
    TXA : ROR A : ROR A : ROR A : AND #&C0     ; (X's low two bits, on top)
    CPY le : BEQ f2_end
    STA t
.f2_src
    LDA &FFFF,Y : TAX : LSR A : LSR A : ORA t
.f2_dst
    STA &FFFF,Y
    INY : BNE f2_byte               ; (always)
.f2_end
    STA &FFFF,Y
    PS_LINE_END f2_src, f2_byte, w, le, lines
.tail
    \ The tail in place, after the last line's zero.
    LDA th : BMI done
    \ preshift_pair's first call, its tail 256 bytes or so from below
    \ 24425: left to the second call (flush).
    BIT defer : BPL now
    LDA m : BPL now
    CMP #a24425 - a24225 : BCS now
    STA ps_m
    ADC tl : SEC : SBC #a24427 - a24225 - 1 : STA ps_end    ; (C clear: BCS)
    LDA k : STA ps_pend
    BNE done                        ; (always)
.now
    LDY yy
    LDA #0 : JSR in_place
.done
    INC rc
    LDA frame
    RTS
.stream
    \ The whole stream, from 24052 (q): 2 * words bytes.
    LDA q : STA p : LDA q+1 : STA p+1
    JSR copy
    LDA m : CMP #&80 : ROR A        ; (SRA)
    ADC #0                          ; (+ the carry it shifted out: the words - 1)
    ASL A : ORA #1 : TAX
    LDA #0 : ROL A : STA th
    TXA : JSR walk
    ASL A : JSR in_place            ; (the last byte ASLed before the first)
    JMP done
    ZA_UNREACHABLE

\ The bytes from p, Y and pages as walk leaves them, shifted right by k
\ in place, A the byte before the first: as the fused copy, each byte's
\ own bits >> k and the byte before's low k bits (X) on top. It reads
\ and writes only main RAM, so it lives in ROOMDATA, paged in for it, as
\ main RAM is short (decision 23).
.in_place
    TAX
    JSR page_rooms
    JSR in_place_r
    JMP page_game
SECTION RoomData
.in_place_r
    LDA k : CMP #4 : BEQ k4 : BCS k6
    LDA p : STA k2_src+1 : STA k2_dst+1
    LDA p+1 : STA k2_src+2 : STA k2_dst+2
.k2
    TXA : ROR A : ROR A : ROR A : AND #&C0
    STA t
.k2_src
    LDA &FFFF,Y : TAX : LSR A : LSR A : ORA t
.k2_dst
    STA &FFFF,Y
    INY : BNE k2
    INC k2_src+2 : INC k2_dst+2
    DEC pages : BPL k2
    RTS
.k4
    LDA p : STA k4_src+1 : STA k4_dst+1
    LDA p+1 : STA k4_src+2 : STA k4_dst+2
.k4_byte
    TXA : ASL A : ASL A : ASL A : ASL A
.k4_src
    LDX &FFFF,Y
    ORA sh_hi4,X
.k4_dst
    STA &FFFF,Y
    INY : BNE k4_byte
    INC k4_src+2 : INC k4_dst+2
    DEC pages : BPL k4_byte
    RTS
.k6
    LDA p : STA k6_src+1 : STA k6_dst+1
    LDA p+1 : STA k6_src+2 : STA k6_dst+2
.k6_byte
    TXA : ASL A : ASL A
.k6_src
    LDX &FFFF,Y
    ORA sh_hi6,X
.k6_dst
    STA &FFFF,Y
    INY : BNE k6_byte
    INC k6_src+2 : INC k6_dst+2
    DEC pages : BPL k6_byte
    RTS
ENDSECTION

\ Each line's w bytes, then a zero, from HL.
.copy
    JSR start_lines : BEQ copied
    LDY #0 : CLC
.copy_line
    \ Y as the fused copy's, but taken back to 0 (q and gfx on by it)
    \ before a line would run it past 255 (or with C set, as after one
    \ that was).
    TYA : ADC w : BCC copy_go
    TYA : CLC : ADC q : STA q
    BCC cl1 : INC q+1
.cl1
    TYA : CLC : ADC gfx : STA gfx
    BCC cl2 : INC gfx+1
.cl2
    LDY #0
.copy_go
    LDX w : BEQ zero
.copy_byte
    LDA (gfx),Y : STA (q),Y
    INY : DEX : BNE copy_byte
.zero
    TXA : STA (q),Y
    INC q : BNE cl3 : INC q+1
.cl3
    DEC lines : BNE copy_line
.copied
    RTS

\ A = (h * (w + 1)) AND 255, Y = its high byte.
.size
    LDA #0 : TAY : LDX w : INX
.mul
    CLC : ADC rb
    BCC mul_nc : INY
.mul_nc
    DEX : BNE mul
    RTS

\ preshift_pair's deferred tail (A = ps_pend, its k; from 24225 + ps_m
\ to 24427 + ps_end), shifted now as it would have been, but for the
\ bytes from 24425 to the end of this call's image (24427 + B * (C + 1)),
\ which this call writes over before anything reads them. Each part is
\ walked as (p),Y with Y running up to 255 at its last byte.
.flush
    STA k
    LDA #0 : STA ps_pend : STA pages
    \ After the image, the byte before it as it was. (An image of 256
    \ bytes or more covers the tail; past its low byte, the part shifted
    \ here is written over, all the same.)
    JSR size
    CMP ps_end : BCS before
    TAX : SEC : SBC ps_end : TAY    ; (C clear after: X < ps_end)
    LDA ps_end : ADC #LO(a24427 - 256) : STA p
    LDA #HI(a24427 - 256) : ADC #0 : STA p+1
    LDA a24427 - 1,X
    JSR in_place
.before
    \ Before 24425, after the line's zero.
    LDA #LO(a24425 - 256) : STA p
    LDA #HI(a24425 - 256) : STA p+1
    LDA ps_m : CLC : ADC #LO(256 - (a24425 - a24225)) : TAY
    LDA #0 : STA pages
    JMP in_place

\ q = HL; lines = B (Z set: none).
.start_lines
    LDA rl : STA q : LDA rh : STA q+1
    LDA rb : STA lines
    RTS

\ The bytes from p, th:A + 1 of them (th 0 or 1), walked as (p),Y with Y
\ running up to the end of a page: p back by Y = 255 - A, pages = th.
\ A = the last byte.
.walk
    EOR #&FF : STA yy
    LDA th : STA pages
    LDA p : SEC : SBC yy : STA p : STA at
    LDA p+1 : SBC #0 : STA p+1
    CLC : ADC pages : STA at+1      ; the last byte: at 255 in the last page
    LDY #255 : LDA (at),Y
    LDY yy
    RTS
}

\ --- Text and scenery ----------------------------------------------------

\ 54464, DrawChar: glyph A of the font at DE (8 bytes from DE + 8A) at
\ character row B, column C, written (not XORed), in ink glyph_ink (the
\ port's: the original's colour is the attribute its callers write).
\ O: HL = the screen address of its top line; A, BC, DE kept. The
\ address is the character-row table 58883's made by arithmetic, so that
\ it needs no GAMEDATA: the room drawing calls this with ROOMDATA paged in.
.z54464
{
    ZA_AUTO2 src
    ZA_AUTO1 n
    ZA_AUTO1 glyph
    STA glyph
    STA src : LDA #0 : STA src+1
    ASL src : ROL src+1 : ASL src : ROL src+1 : ASL src : ROL src+1
    LDA src : CLC : ADC re : STA src
    LDA src+1 : ADC rd : STA src+1
    \ HL = row B's address (&4000 + (B AND &18) * 256 + (B AND 7) * 32) + C.
    LDA rb : AND #7 : ASL A : ASL A : ASL A : ASL A : ASL A
    CLC : ADC rc : STA rl
    LDA rb : AND #&18 : ORA #&40 : ADC #0 : STA rh
    LDA #0 : STA n
.each_line
    LDA rh : CLC : ADC n : TAY      ; (INC H a line)
    LDX rl
    STY src_y
    LDY n : LDA (src),Y
    LDY src_y
    JSR put_zx
    INC n : LDA n : CMP #8 : BNE each_line
    LDA glyph
    RTS
}
ZA_AUTO1 src_y

\ 54363, PrintString: the string at HL from character row B, column C.
\ '$' ends it; 13 starts the next row at the first column; 128 + n sets
\ the attribute n (24024) for what follows; '0'-'9' and 'A'-'Z' are glyphs
\ 0-35, others go through 57817 to 57844 (or are their own glyph number
\ if not there). Each glyph is written (54464) in the attribute's ink and
\ its attribute set. O: HL at the '$'; BC kept.
.z54363
{
    ZA_AUTO2 str
    ZA_AUTO1 col0
    LDA rl : STA str : LDA rh : STA str+1
    LDA rc : STA col0
.next
    LDY #0 : LDA (str),Y
    CMP #'$' : BEQ end
    CMP #13 : BNE not_cr
    INC rb : LDA col0 : STA rc
    JMP advance
    ZA_UNREACHABLE
.not_cr
    CMP #128 : BCC not_attr
    AND #127 : STA a24024
    JMP advance
    ZA_UNREACHABLE
.not_attr
    CMP #'0' : BCC other
    CMP #'9' + 1 : BCS letter
    SEC : SBC #'0'
    JMP glyph
    ZA_UNREACHABLE
.letter
    CMP #'A' : BCC other
    CMP #'Z' + 1 : BCS other
    SEC : SBC #'A' - 10
    JMP glyph
    ZA_UNREACHABLE
.other
    LDX #0
.find
    CMP a57817,X : BEQ found
    INX : CPX #27 : BNE find
    JMP glyph                       ; (not there: the character is the glyph)
    ZA_UNREACHABLE
.found
    LDA a57844,X
.glyph
    TAX
    LDA a24024 : AND #7 : STA glyph_ink
    LDA #LO(r_font) : STA re : LDA #HI(r_font) : STA rd
    TXA : JSR z54464
    LDA #LO(22528) : STA re : LDA #HI(22528) : STA rd
    JSR z57341
    LDA rh : CLC : ADC #ATTR_HI : STA rh
    LDY #0 : LDA a24024 : STA (rl),Y
    INC rc
.advance
    INC str : BNE adv : INC str+1
.adv
    JMP next
    ZA_UNREACHABLE
.end
    LDA str : STA rl : LDA str+1 : STA rh
    LDA col0 : STA rc
    LDA #'$'
    RTS
}

\ 53087, Cls: the screen and attributes to 0, and the scenery inks with
\ them. The original's LDDR stops short of the screen's first byte
\ (16384), black on black there once its attribute is 0; here a pixel's
\ colour is its row's, so that byte is cleared too (decision 20).
.z53087
{
    JSR cls
    LDA #0 : TAX
.each
    STA attrs,X : STA attrs+256,X : STA attrs+512,X
    STA scen_ink,X : STA scen_ink+256,X : STA scen_ink+512,X
    INX : BNE each
    RTS
}

\ 53931, ClearLines: B pixel lines to 0 from line A. O: A = A + B, B = 0,
\ HL = the last line's end; C, DE kept.
.z53931
{
    ZA_AUTO1 n
    ZA_AUTO1 line
    STA line
.each_line
    LDA line : JSR z57307
    LDA #32 : STA n
.byte
    LDX rl : LDY rh : JSR zap_zx
    INC rl : BNE inced : INC rh
.inced
    DEC n : BNE byte
    INC line
    DEC rb : BNE each_line
    LDA line
    RTS
}

\ Zero the Spectrum screen byte at X (low), Y (high) (an address in the
\ attributes zeroes the attribute, as LD (HL),0 would).
.zap_zx
{
    CPY #&58 : BCS attr
    TYA : AND #7 : ORA zx_lo,X : STA zx_ptr
    TYA : AND #&18 : ASL A : ADC zx_hi,X : STA zx_ptr+1
    LDA #0 : TAY : STA (zx_ptr),Y
    LDY #8 : STA (zx_ptr),Y
    RTS
.attr
    CPY #&5B : BCS none
    STX zx_ptr
    TYA : CLC : ADC #ATTR_HI : STA zx_ptr+1
    LDA #0 : TAY : STA (zx_ptr),Y
.none
    RTS
}
