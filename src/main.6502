\ ***************************************************************************
\ CAULDRON II for the BBC Micro - build file
\
\ !BOOT runs C2, whose loader loads TITLE (the Spectrum's loading screen,
\ converted by tools/mkscreen.py) straight into screen memory, then copies
\ the game down to &0E00 and runs it: it takes the machine over and shows
\ TITLE in the Spectrum's geometry. (C2 loads TITLE, not !BOOT: the OS
\ echoes !BOOT's lines into MODE 7's screen, which is inside ours.)
\ ***************************************************************************

INCLUDE "defs.6502"
INCLUDE "lib/zx02.6502"                 ; (baron's example compressor, for C2's code)
INCLUDE "regs.6502"
INCLUDE "../build/syms.6502"

\ The build stamp comes from the Makefile (-D BUILD="date time sha"), so a
\ disc says what it is: *TYPE !BOOT shows it. A + after the sha means the
\ tree had uncommitted changes.
IF DEFINED(BUILD)
    build_stamp = BUILD
ELSE
    build_stamp = "DEV"
ENDIF

\ The game's permanent zero page, below the allocator's pool.
ZP_FIXED = &70
vsyncs      = ZP_FIXED + 0      ; VSyncs so far (irq.6502)
splits_on   = ZP_FIXED + 1      ; the palette splits run (irq.6502)
irq_split   = ZP_FIXED + 2      ; 4 * the next split
vsync_hook  = ZP_FIXED + 3      ; called at VSync if its high byte isn't 0 (2 bytes)
unwritten_at = ZP_FIXED + 5     ; the original's address of a stub reached (2 bytes)
zx_ptr      = ZP_FIXED + 7      ; zxscreen.6502's: our screen address (2 bytes)
zx_tmp      = ZP_FIXED + 9
game_bank   = ZP_FIXED + 10     ; the sideways banks the loader filled: GAMEDATA
room_bank   = ZP_FIXED + 11     ; ... and ROOMDATA (room.6502's page_game, page_rooms)
xor_erase   = ZP_FIXED + 12     ; non-zero: the next 57058 / 57194 erases (draw.6502)
glyph_ink   = ZP_FIXED + 13     ; the ink 54464 writes in (draw.6502)
machine     = ZP_FIXED + 14     ; OSBYTE 0's X, read by C2's loader (input.6502's joy_init)
xr_cache    = ZP_FIXED + 15     ; xor_down's working, kept from one run to the next (draw.6502; 8 bytes)
ZP_END      = ZP_FIXED + 23
    ASSERT ZP_END <= &90        ; (&90-&9F: Econet, &A0-: the OS's NMI and beyond)

SECTION Boot, filename = "!BOOT", exec = &FFFFFFFF
    EQUS "*| CAULDRON II ", build_stamp, 13
    EQUS "*RUN LOADER", 13
ENDSECTION

SECTION Title, org = screen, load = &FFFF0000 OR screen, exec = &FFFF0000 OR screen, filename = "TITLE"
    INCBIN "../build/data/title.bin"
    ASSERT P% = &8000
ENDSECTION

LD_SRC = &80                        ; (the loaders' zero page: the game's isn't set up)
LD_DST = &82

\ The original's data (tools/mkdata.py, build/data) in two sideways RAM
\ banks (decision 9): GAMEDATA, the sprites and the tables, paged in all
\ the time; ROOMDATA, the rooms' tiles, blocks, layouts and attributes
\ and their colour plans, paged in while a room draws. LOADER stages each
\ file at DATA_LOAD and copies it to a free bank.
DATA_LOAD = &1900
SECTION GameData, org = &8000, load = &FFFF0000 OR DATA_LOAD, exec = &FFFF0000 OR DATA_LOAD, filename = "GAMEDAT", guard = &C000
    INCLUDE "../build/data/gamedata.6502"
    INCLUDE "../build/data/font.6502"   ; (r_font: the font; GAMEDATA is paged in whenever text prints)
    \ (draw.6502 adds the sprite routines; gamedata_end follows the code)
ENDSECTION
SECTION RoomData, org = &8000, load = &FFFF0000 OR DATA_LOAD, exec = &FFFF0000 OR DATA_LOAD, filename = "ROOMDAT", guard = &C000
    INCLUDE "../build/data/roomdata.6502"
.roomdata_end
    PRINT "ROOMDATA &8000-&", ~roomdata_end, " (", &C000 - roomdata_end, " bytes free)"
    ASSERT DATA_LOAD + roomdata_end - &8000 <= LOADER_ORG
ENDSECTION

\ LOADER: !BOOT runs it first, high in memory (below MODE 7's screen). It
\ stages GAMEDAT and ROOMDAT at DATA_LOAD, copies each to a sideways RAM
\ bank, leaves their numbers in game_bank and room_bank, and runs C2.
LOADER_ORG = &7000
SECTION Banks, org = LOADER_ORG, load = &FFFF0000 OR LOADER_ORG, exec = &FFFF0000 OR LOADER_ORG, filename = "LOADER"
    LDA #&FF : STA game_bank        ; (no bank yet)
    LDX #LO(load_game) : LDY #HI(load_game)
    LDA #HI(gamedata_end - 1) + 1 : JSR load_bank
    STX game_bank
    LDX #LO(load_rooms) : LDY #HI(load_rooms)
    LDA #HI(roomdata_end - 1) + 1 : JSR load_bank
    STX room_bank
    LDA game_bank : STA romshad : STA romsel
    LDX #LO(run_game) : LDY #HI(run_game) : JMP oscli
.run_game   EQUS "RUN C2", 13
\ *LOAD the file whose command is at X, Y, and copy it from DATA_LOAD to
\ the highest free sideways RAM bank (no ROM found there at start-up, a
\ byte at &8000 can be flipped, and not game_bank), up to the page A.
\ O: X = the bank. Without one, say so and stop.
.load_bank
{
    STA ld_end
    JSR oscli
    SEI
    LDX #15
.free
    LDA romtypes,X : BNE not_free
    CPX game_bank : BEQ not_free
    STX romsel
    LDA &8000 : EOR #&FF : STA &8000
    CMP &8000 : BEQ found
.not_free
    DEX : BPL free
    LDA romshad : STA romsel
    CLI
    LDX #0
.say
    LDA no_ram,X : JSR osasci
    INX : CPX #no_ram_end - no_ram : BNE say
.stop
    JMP stop
.found
    STX romshad
    LDA #HI(DATA_LOAD) : STA LD_SRC+1 : LDA #&80 : STA LD_DST+1
    ASSERT LO(DATA_LOAD) = 0
    LDY #0 : STY LD_SRC : STY LD_DST
.copy
    LDA (LD_SRC),Y : STA (LD_DST),Y
    INY : BNE copy
    INC LD_SRC+1 : INC LD_DST+1
    LDA LD_DST+1 : CMP ld_end : BNE copy
    CLI
    RTS
}
ld_end = LD_DST + 2
.load_game  EQUS "LOAD GAMEDAT", 13         ; (at its own address, DATA_LOAD)
.load_rooms EQUS "LOAD ROOMDAT", 13
.no_ram     EQUS "Cauldron II needs 32K of sideways RAM", 13
.no_ram_end
.banks_end
    ASSERT banks_end <= &7C00
ENDSECTION

\ C2: the game, assembled to run from &0E00 (the DFS's workspace, free
\ once the game owns the machine), loaded at &1900 with its loader. The
\ code is packed (baron's zx02 transform, decision 16): unpacked it would
\ run past the screen's start from &1900, where the DFS loads files.
SECTION Loader, org = &1900, load = &FFFF1900, exec = &FFFF0000 + loader, filename = "C2"
\ C2's loader: runs where the file loaded, before the packed payload,
\ and nothing in it is wanted afterwards. TITLE into the screen, with the
\ OS and the DFS; then the machine is the game's: the packed code is
\ moved up to end at the screen's start, and the unpacker, copied to page
\ 4 (the attributes', not yet in use), unpacks it down to &0E00 over the
\ DFS's workspace and the loader. The packed bytes end above the unpacked
\ code, so the unpacking never overtakes them.
.loader
{
    LDX #LO(title_block) : LDY #HI(title_block)
    LDA #&FF : JSR osfile           ; load TITLE at its own address
    LDA #0 : LDX #1 : JSR osbyte : STX machine
    SEI                             ; the interrupts stay off until install_irq
    \ The packed bytes up, last byte first (they move up over themselves).
    LDA #LO(payload_end) : STA LD_SRC : LDA #HI(payload_end) : STA LD_SRC+1
    LDA #LO(PACKED_TOP) : STA LD_DST : LDA #HI(PACKED_TOP) : STA LD_DST+1
    LDX #HI(payload_end - payload + &FF)
    LDY #0
.up
    LDA LD_SRC : BNE up_lo : DEC LD_SRC+1
.up_lo
    DEC LD_SRC
    LDA LD_DST : BNE up_dlo : DEC LD_DST+1
.up_dlo
    DEC LD_DST
    LDA (LD_SRC),Y : STA (LD_DST),Y
    LDA LD_SRC : CMP #LO(payload) : BNE up
    LDA LD_SRC+1 : CMP #HI(payload) : BNE up
    \ The unpacker to page 4.
    LDX #unpacker_end - unpacker_start
.tramp
    LDA unpacker_payload - 1,X : STA unpacker_start - 1,X
    DEX : BNE tramp
    JMP unpack_game
}

\ The unpacker, assembled for page 4 and carried here.
.unpacker_payload
    SECTION Unpacker, org = &0400
    ZA_POOL &00..ZP_REGS-1
.unpacker_start
.unpack_game
{
    ZA_ENTRY
    LDA #LO(PACKED_TOP - (payload_end - payload)) : STA src
    LDA #HI(PACKED_TOP - (payload_end - payload)) : STA src+1
    LDA #LO(code_start) : STA dst : LDA #HI(code_start) : STA dst+1
    JSR unpack
    JMP start
}
    INCLUDE "lib/dzx02.6502"
.unpacker_end
    ASSERT unpacker_end <= &0700    ; (page 4 to 6 only: the attributes)
    ENDSECTION

\ OSFILE's block for loading TITLE where it was saved.
.title_block
    EQUW title_name
    EQUD 0, &FFFFFFFF               ; (exec's low byte non-zero: its own address)
    EQUD 0, 0
.title_name
    EQUS "TITLE", 13

.payload
    SECTION Code, org = &0E00, guard = screen, transform = "zx02"
    ZA_POOL &00..ZP_REGS-1
.code_start

.start
{
    ZA_ENTRY
    LDX #&FF : TXS
    JSR init_system
    \ GAMEDATA (LOADER's bank), which the OS paged out for its own ROMs.
    LDA game_bank : STA romshad : STA romsel
    JSR init_zxscreen
    JSR init_draw
    JSR plain_colours
IF DEFINED(VIEWER)
    LDA #0 : STA view_game : STA view_num
ENDIF
    LDA #LO(title_palette) : LDY #HI(title_palette) : JSR set_palette
    JSR screen_on
}
.shown                              ; (global: the tools run to here)
    JSR any_key : BEQ shown
IF DEFINED(VIEWER)
    LDA view_game : BNE game        ; (a tool may poke it: the game, not the viewer)
    JMP viewer                      ; (room.6502: the drawing's checks)
.game
    JMP z52180
ELIF DEFINED(DEMO_ROOM)
    JMP demo                        ; (room.6502: until game.6502 has 52180)
ELSE
    JMP z52180                      ; the original's entry (game.6502)
ENDIF

\ A transcribed routine called one not yet written (build/stubs.6502):
\ stop, with the original's address in unwritten_at for the tools.
.unwritten
    STA unwritten_at : STX unwritten_at+1
    SEI
.unwritten_stop
    JMP unwritten_stop

    INCLUDE "system.6502"
    INCLUDE "irq.6502"
    INCLUDE "screen.6502"
    INCLUDE "zxscreen.6502"
    INCLUDE "draw.6502"
    INCLUDE "room.6502"
    INCLUDE "game.6502"
    INCLUDE "objects.6502"
    INCLUDE "player.6502"
    INCLUDE "input.6502"
    INCLUDE "frontend.6502"
    INCLUDE "sound.6502"
    INCLUDE "../build/data/title.6502"
    INCLUDE "../build/stubs.6502"
.code_end
    ENDSECTION
.payload_end

.loader_end
    ASSERT loader_end <= screen      ; (TITLE loads over the screen after it)
\ Where the packed bytes end once moved, and the unpacking's margin: it
\ never writes past what it has read when the packed bytes end at least
\ this far above the unpacked code's end.
PACKED_TOP = screen
    ASSERT PACKED_TOP >= code_end + 16
    ASSERT PACKED_TOP >= payload_end    ; (the packed bytes move up, clear of the loader before them)
ENDSECTION

SECTION GameData
.gamedata_end
    PRINT "GAMEDATA &8000-&", ~gamedata_end, " (", &C000 - gamedata_end, " bytes free)"
    ASSERT DATA_LOAD + gamedata_end - &8000 <= LOADER_ORG
ENDSECTION

\ The original's attribute file, kept exactly as the original's
\ (decision 5): page-aligned, so a Z80 attribute address's high byte
\ (&58-&5A) becomes ours by adding ATTR_HI.
SECTION Attrs, org = &0400, virtual = TRUE
.attrs      SKIP 768
ENDSECTION
ATTR_HI = HI(attrs) - &58
\ The original's variables, object slots and buffers (24000-25099), in
\ its own layout: aNNNNN names each (tools/mksyms.py). Pages 4 to &0C are
\ the OS's and BASIC's, free once the game owns the machine.
SECTION Vars, org = &0700, virtual = TRUE
.vars       SKIP 25100 - 24000
\ After them, to page &0D, the palette's workspace.
.frame_ula      SKIP 16         ; the palette VSync writes (irq.6502)
.split_ula      SKIP 4 * MAX_SPLITS ; each split's four writes
.split_latch    SKIP 2 * (MAX_SPLITS + 1)   ; T1's periods
.rp1            SKIP SCREEN_ROWS ; each row's logical 1-3 colours (room.6502)
.rp2            SKIP SCREEN_ROWS
.rp3            SKIP SCREEN_ROWS
PAL_PROG_LEN = 1 + 4 + 2 * MAX_SPLITS + 2 * (MAX_SPLITS + 1)
.pal_prog       SKIP PAL_PROG_LEN ; the screen's palette program (make_program)
.split_lines    SKIP MAX_SPLITS ; ... its splits' lines
.pat_q          SKIP 4          ; make_patterns' row: logical 1-3 at +1
.ps_pend        SKIP 1          ; preshift_pair's deferred tail's shift (0: none) (draw.6502) ...
.ps_m           SKIP 1          ; ... from 24225 + ps_m
.ps_end         SKIP 1          ; ... to 24427 + ps_end
    ASSERT P% <= &0D00              ; (page &0D: the NMI and the Master's vectors)
ENDSECTION

\ The game's workspace, after its code: not in the file.
SECTION Work, org = code_end, guard = screen, virtual = TRUE
    ALIGN &100
.zx_lo          SKIP 256        ; zxscreen.6502's tables
.zx_hi          SKIP 256
.lit_lo         SKIP 256
.spread_hi      SKIP 256        ; draw.6502's
.spread_lo      SKIP 256
.unlit          SKIP 256
.pat_even       SKIP 8 * SCREEN_ROWS    ; the rows' ink patterns (room.6502's make_patterns)
.pat_odd        SKIP 8 * SCREEN_ROWS    ; (xor_down: pat_even + the line's parity * 8 * SCREEN_ROWS)
\ Variables, in what the patterns leave of their two pages.
.bank_list      SKIP BANK_LIST_MAX  ; the room's tile-bank list (62954), copied
IF DEFINED(VIEWER)
.view_num       SKIP 1          ; the viewer's room (tools/roomcheck.mjs sets it)
.view_shown     SKIP 1          ; ... and the one drawn
.view_game      SKIP 1          ; non-zero: a key starts the game instead
TEST_CALLS = 16
.test_n         SKIP 1          ; the sprite calls to make (tools/spritecheck.mjs)
.test_calls     SKIP 6 * TEST_CALLS
ENDIF
    ASSERT P% <= pat_even + &200
    ALIGN &100
.scen_ink       SKIP 768        ; each cell's scenery ink (draw.6502)
.work_end
    PRINT "code &0E00-&", ~code_end, ", workspace to &", ~work_end, " (", screen - work_end, " bytes free)"
ENDSECTION
